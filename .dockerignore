# The build context was ~260 MB, almost all of it things the image never needs:
# the UI is compiled inside the image from source, and the host binary is
# irrelevant to a cross-platform build.
ui/node_modules/
node_modules/
internal/web/dist/
/polyemesis
/dist/
/data/
.git/
.playwright-mcp/
*.db
*.db-wal
*.db-shm

# Key material, by name rather than by location — same reasoning as .gitignore,
# and the same anchoring gap: /data/ above is rooted at the context root while
# dataDir is configurable.
#
# The final image is not at risk: it copies only the binary. The BUILD STAGE is,
# because the Dockerfile does `COPY . .`, and release.yml exports layers with
# `cache-to: type=gha,mode=max` — which includes intermediate layers, not just
# the final one. A stray secret.key would ride along into that cache.
secret.key
ca.key
server.key
*.pem
scripts/
docs/
.DS_Store

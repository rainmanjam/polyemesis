---
/* A numbered sequence of steps. Each step is its title, one line per fact (the
 * fact's evidence is tested against the doc it names, lib/facts.ts), a row of
 * links to those docs and, when it has one, a screenshot. The numbering is the
 * list's own: this is a real sequence. Rules are in styles/new-pages.css. */
import Shot from "./Shot.astro";
import { docLinksOf, type Step } from "../../lib/facts";

interface Props {
  steps: Step[];
  idPrefix?: string;
  /** Extra lines under a step, keyed by its 1-based number (the sports page lists what each destination hears). */
  notes?: Record<number, string[]>;
}

const { steps, idPrefix = "step", notes = {} } = Astro.props;
---

<ol class="steps" role="list">
  {
    steps.map((step, i) => (
      <li class="step" id={`${idPrefix}-${i + 1}`}>
        <h3>{step.title}</h3>
        {step.facts.map((f) => <p class="fact">{f.text}</p>)}
        <p class="docrow">
          {docLinksOf(step.facts).map((l) => <><a href={l.href}>{l.text}</a>{" "}</>)}
        </p>
        {notes[i + 1] && <p class="docrow">In this example:</p>}
        {notes[i + 1] && <ul class="mixes">{notes[i + 1].map((n) => <li>{n}</li>)}</ul>}
        {step.shot && <Shot shot={step.shot.file} alt={step.shot.alt} chrome={step.shot.chrome} caption={step.shot.caption} />}
      </li>
    ))
  }
</ol>

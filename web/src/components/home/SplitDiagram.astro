---
/* THE SPLIT DIAGRAM: one video and four tracks go into polyemesis, and each
 * destination comes out with the same video and its own mix.
 *
 * Server-rendered and readable with no JavaScript: the chips, the hub and the
 * destination cards are ordinary markup, and the lines are a decorative SVG
 * behind them. The home page renders this four times (three hero story panels
 * and how-it-works), so it carries no ids; the hero owns the tabpanel wrapper
 * and its `hidden` attribute.
 *
 * GEOMETRY. Both layouts are drawn at build time from geometry.ts and CSS shows
 * one: `h` at 768px and up, `v` below. The SVG is stretched to the grid box
 * (preserveAspectRatio none, non-scaling strokes), and the grid tracks below
 * use the same fractions as anchors(), so every line ends under its card at
 * any width. Grid tracks are minmax(0, fr) with no gap, so a long label can
 * make a card taller without moving a row centre; spacing comes from padding
 * inside each cell.
 *
 * SCRIPT HAND-OFF. Destination cards are divs carrying data-label; the hero
 * script swaps them for buttons and moves data-label to the accessible name.
 * A created button has no Astro scope attribute, so every card rule is written
 * `.dg :global(.dest …)` and holds for both elements with identical boxes:
 * nothing changes size when the swap happens.
 *
 * COLOUR. Slots --t1..--t4 read the site's track tokens through var(); Sports
 * and Worship rebind them for their language lanes. No colour literals here.
 * The same language keeps the same colour across stories (Spanish is teal in
 * both), and music keeps the streamer's magenta.
 *
 * MOTION. Only the audio dashes move, and only when the page's motion gate is
 * on (html.motion-on) and the diagram is on screen (.is-playing).
 */
import { STORIES, destLabel, type StoryKey } from "../../scripts/home/stories";
import { ON, VIEWBOX, linesFor, type Layout, type Line } from "../../scripts/home/geometry";

interface Props {
  story: StoryKey;
  mode: "hero" | "steps";
}

const { story, mode } = Astro.props;
const s = STORIES[story];
const layouts: Layout[] = ["h", "v"];

/** A source line takes its track's colour; hub lines are video or the mix. */
function lineColour(l: Line): string {
  if (typeof l.from === "number") return l.from === 0 ? "var(--dg-video)" : `var(--t${l.from})`;
  return l.kind === "video" ? "var(--dg-video)" : "var(--dg-mix)";
}
const pct = (g: number) => `${g * 100}%`;
---

<div class="dg" data-dg data-story={story} data-mode={mode}>
  {
    layouts.map((layout) => (
      <svg
        class="dg-lines"
        aria-hidden="true"
        focusable="false"
        data-layout={layout}
        viewBox={`0 0 ${VIEWBOX[layout].w} ${VIEWBOX[layout].h}`}
        preserveAspectRatio="none"
      >
        {linesFor(s, layout).map((l) => (
          <path
            class={`ln ln-${l.kind}`}
            d={l.d}
            data-from={String(l.from)}
            data-to={l.to}
            data-on={l.on}
            style={`--c:${lineColour(l)}`}
          />
        ))}
      </svg>
    ))
  }

  <ul class="src" aria-label="Tracks from your encoder">
    <li class="si" data-src="0" data-on={ON.srcVideo} style="--c:var(--dg-video)">
      <i class="sw" aria-hidden="true"></i><span>Video</span>
    </li>
    {
      s.tracks.map((t, i) => (
        <li class="si" data-src={String(i + 1)} data-on={ON.srcTrack} style={`--c:var(--t${i + 1})`}>
          <i class="sw" aria-hidden="true" />
          <span>{t.name}</span>
        </li>
      ))
    }
  </ul>

  <div class="hub" data-on={ON.hub}>polyemesis</div>

  <ul class="dests" aria-label="Destinations">
    {
      s.dests.map((d) => (
        <li>
          <div class="dest" data-dest={d.id} data-on={ON.dest} data-label={destLabel(s, d)}>
            <span class="dest-name">{d.name}</span>
            <span class="dest-sub">{d.sub}</span>
            <span class="dest-mix">
              <span class="pips" aria-hidden="true">
                {d.mix.map((g, i) => (
                  <i class="pip" style={`--c:var(--t${i + 1});--g:${pct(g)}`} />
                ))}
              </span>
              {d.video && (
                <span class="vid">
                  <span class="sr-only">With video</span>
                </span>
              )}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .dg {
    /* Track slots: mic, music, game, co-host (Global Constraints). */
    --t1: var(--color-meter);
    --t2: var(--color-cohost);
    --t3: var(--color-game);
    --t4: var(--color-second-voice);
    --dg-video: var(--color-fg);
    --dg-mix: var(--color-muted);

    position: relative;
    display: grid;
    padding: 0;
    /* v layout (phones): sources .00-.20, hub .32-.48, destinations .56-1.
       Mirrors V_SRC_Y / V_HUB_Y / V_DST_TOP in geometry.ts. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows:
      minmax(0, 20fr) minmax(0, 12fr) minmax(0, 16fr) minmax(0, 8fr)
      minmax(0, 44fr);
    min-height: 36rem;
  }
  /* Language lanes: each story maps its four lanes one-to-one onto the four
     track tokens. Never --color-muted: that is --dg-mix, the hub-to-destination
     audio line, so a lane in it would read as the mix. */
  .dg[data-story="sports"] {
    --t1: var(--color-cohost); /* ambience */
    --t2: var(--color-meter); /* home commentary */
    --t3: var(--color-game); /* away commentary */
    --t4: var(--color-second-voice); /* Spanish */
  }
  .dg[data-story="worship"] {
    --t1: var(--color-game); /* room */
    --t2: var(--color-meter); /* English */
    --t3: var(--color-second-voice); /* Spanish */
    --t4: var(--color-cohost); /* music */
  }

  .dg-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .dg-lines[data-layout="h"] {
    display: none;
  }

  .ln {
    fill: none;
    stroke: var(--c);
    stroke-width: 2;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.85;
  }
  .ln-video {
    stroke-width: 2.5;
  }
  .ln-audio {
    stroke-dasharray: 6 8;
  }

  /* Cards sit above the lines. */
  .src,
  .hub,
  .dests {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  /* Sources: a top row of five on phones, a column on wide screens. */
  .src {
    grid-row: 1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr);
  }
  .si {
    align-self: center;
    margin: 0 0.125rem;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.125rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .sw {
    display: block;
    flex: none;
    width: 100%;
    max-width: 1.5rem;
    height: 0.1875rem;
    border-radius: 2px;
    background: var(--c);
  }

  .hub {
    grid-row: 3;
    align-self: center;
    justify-self: center;
    width: 60%;
    padding: 0.625rem 0.75rem;
    background: var(--color-raised);
    border: 1px solid var(--color-line-strong);
    border-radius: 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
    text-align: center;
  }

  /* Destinations: 2 x 2 on phones, a column of n on wide screens. */
  .dests {
    grid-row: 5;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }
  .dests > li {
    display: grid;
    align-items: center;
    min-width: 0;
    padding: 0.25rem;
  }

  /* The card. :global so the button the hero script swaps in gets the same box. */
  .dg :global(.dest) {
    box-sizing: border-box;
    appearance: none;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0.5rem 0.625rem;
    font: inherit;
    color: inherit;
    text-align: left;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem;
  }
  .dg :global(button.dest) {
    cursor: pointer;
  }
  .dg :global(.dest[aria-pressed="true"]) {
    border-color: var(--color-fg);
  }
  .dg :global(.dest-name) {
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .dg :global(.dest-sub) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--color-muted);
    overflow-wrap: anywhere;
  }
  .dg :global(.dest-mix) {
    display: flex;
    align-items: flex-end;
    gap: 0.375rem;
  }
  .dg :global(.pips) {
    display: flex;
    align-items: flex-end;
    gap: 0.1875rem;
  }
  /* A pip is a small fader: the outline is the track, the fill its gain. */
  .dg :global(.pip) {
    position: relative;
    display: block;
    width: 0.375rem;
    height: 0.875rem;
    border: 1px solid var(--c);
    border-radius: 2px;
    overflow: hidden;
  }
  .dg :global(.pip)::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: var(--g, 0%);
    background: var(--c);
  }
  .dg :global(.vid) {
    display: block;
    width: 0.875rem;
    height: 0.5625rem;
    border-radius: 2px;
    background: var(--dg-video);
  }

  /* States: opacity only. */
  .si,
  .hub,
  .ln,
  .dg :global(.dest) {
    transition: opacity 220ms var(--ease-out);
  }
  .dg :global(.dim) {
    opacity: 0.25;
  }
  .dg :global(.ln.dim) {
    opacity: 0.08;
  }
  .dg :global(.off) {
    opacity: 0.12;
  }
  .dg :global(.is-solo) {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .dg {
      /* h layout: column centres at 9%, 50% and 91% (anchors("h")). */
      grid-template-columns:
        minmax(0, 18fr) minmax(0, 22fr) minmax(0, 20fr) minmax(0, 22fr)
        minmax(0, 18fr);
      grid-template-rows: minmax(0, 1fr);
      min-height: 22rem;
    }
    .dg-lines[data-layout="h"] {
      display: block;
    }
    .dg-lines[data-layout="v"] {
      display: none;
    }
    .src {
      grid-row: 1;
      grid-column: 1;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(5, minmax(0, 1fr));
    }
    .si {
      flex-direction: row;
      justify-content: flex-start;
      gap: 0.5rem;
      margin: 0;
      padding: 0.375rem 0.5rem;
      font-size: 0.75rem;
      text-align: left;
    }
    .sw {
      width: 0.625rem;
      height: 0.625rem;
      border-radius: 3px;
    }
    .hub {
      grid-row: 1;
      grid-column: 3;
      width: 100%;
      padding: 0.875rem 0.5rem;
      font-size: 1.0625rem;
    }
    .dests {
      grid-row: 1;
      grid-column: 5;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(4, minmax(0, 1fr));
    }
    .dests > li {
      padding: 0.25rem 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-on) .dg.is-playing .ln-audio {
      animation: dg-flow 1.9s linear infinite;
    }
  }
  @keyframes dg-flow {
    to {
      stroke-dashoffset: -14;
    }
  }
</style>

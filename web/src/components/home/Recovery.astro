---
import { Picture } from "astro:assets";
import chat from "../../assets/shots/09-chat.png";
import { lqipStyle } from "../../lib/lqip";
import { STAGES } from "../../scripts/home/failover";

/* Beat 4. The failover diagram is illustrative: four stages stepped by
 * scripts/home/failover.ts, with no timestamps because nothing here is live.
 * Failover is opt-in, so the copy says "Turn on failover" rather than promising
 * the stream survives by default. The chat half is the real capture, not a
 * drawn feed.
 *
 * The stage buttons and "Pull the cable" do nothing without script, so they
 * ship hidden ([data-fo-controls]) and failover.ts shows them. .fo-head keeps
 * their height meanwhile, so showing them moves nothing. The log is
 * aria-live="off" here; failover.ts makes it polite only for runs the visitor
 * starts. */
const chatPlaceholder = await lqipStyle(chat);
const DESTS = ["Twitch", "YouTube", "Kick"];
const facts = [
  { t: "Slate on drop", d: "A slate goes out while your encoder reconnects, so no destination restarts." },
  { t: "Backup ingest", d: "A second path in, ready if the first one fails." },
  { t: "IRL over SRTLA", d: "A bonded backpack keeps streaming when one of its links drops." },
  { t: "Stop on ingest loss", d: "Opt in, and the live destinations stop if no encoder comes back within the wait you set." },
];
---

<section class="wrap py-20 sm:py-24" id="recover" aria-labelledby="h-recover" data-failover>
  <h2 id="h-recover" class="font-display text-3xl font-medium tracking-tight sm:text-4xl">
    With failover on, your stream stays up when your encoder drops.
  </h2>
  <p class="mt-4 max-w-2xl text-muted">
    Turn on failover and a slate holds every destination while the encoder reconnects, and chat from Twitch, YouTube and Kick stays in one place.
  </p>

  <div class="mt-10 grid gap-6 lg:grid-cols-[1.25fr_1fr] lg:items-stretch">
    <div class="rounded-token border border-line bg-surface p-4">
      <div class="fo-head mb-3">
        <div class="grid gap-3 sm:flex sm:items-center sm:justify-between" data-fo-controls hidden>
          <ol class="fo-steps grid grid-cols-2 gap-1 sm:flex sm:flex-wrap" aria-label="Failover stages">
            {
              STAGES.map((s, i) => (
                <li>
                  <button type="button" data-stage={i} class="fo-step w-full sm:w-auto">{s.label}</button>
                </li>
              ))
            }
          </ol>
          <button type="button" data-play class="fo-play">Pull the cable</button>
        </div>
      </div>

      <div class="fo-frame relative aspect-video overflow-hidden rounded-token border border-line bg-ink" data-frame data-state="live">
        <div class="fo-scene" aria-hidden="true">
          <span class="fo-cap">your show</span>
          <i class="fo-lv" style="--c: var(--color-meter)"></i>
          <i class="fo-lv" style="--c: var(--color-cohost)"></i>
          <i class="fo-lv" style="--c: var(--color-game)"></i>
          <i class="fo-lv" style="--c: var(--color-second-voice)"></i>
        </div>
        <div class="fo-slate" aria-hidden="true">
          <b class="font-display">Back in a moment</b>
          <span>slate</span>
        </div>
        <div class="fo-enc">
          <i class="fo-lamp" aria-hidden="true"></i>
          <span data-enc>Encoder connected</span>
        </div>
      </div>

      <ul class="mt-3 grid grid-cols-3 gap-2" aria-label="Destination status">
        {
          DESTS.map((d) => (
            <li class="flex items-center gap-2 rounded-lg border border-line bg-ink px-2.5 py-2 text-sm">
              <i class="fo-lamp" aria-hidden="true" />
              <span>{d}</span>{" "}
              <span class="ml-auto font-mono text-xs text-muted" data-dest>
                live
              </span>
            </li>
          ))
        }
      </ul>

      <ol class="mt-3 flex min-h-[5.6em] flex-col gap-1 font-mono text-xs text-muted" data-log aria-live="off" aria-label="Event log, illustrative">
        <li>{STAGES[0].log}</li>
      </ol>
    </div>

    <div class="flex flex-col rounded-token border border-line bg-surface p-4">
      <h3 class="font-display text-xl font-medium tracking-tight">One chat for Twitch, YouTube and Kick</h3>
      <p class="mb-3 mt-1 text-[15px] text-muted">Read, send and moderate all three from one window.</p>
      <Picture
        src={chat}
        formats={["avif", "webp"]}
        widths={[420, 690, 960]}
        sizes="(min-width: 1024px) 560px, calc(100vw - 2.5rem)"
        loading="lazy"
        decoding="async"
        alt="polyemesis chat timeline merging YouTube, Twitch, Kick and Facebook messages, with platform toggles above, a poll result marked as sent by polyemesis, and a send box whose chips show YouTube and Twitch selected and Kick not"
        class="w-full rounded-token border border-line"
        style={chatPlaceholder}
        pictureAttributes={{ class: "block" }}
      />
    </div>
  </div>

  <ul class="mt-8 grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      facts.map((f) => (
        <li class="text-sm text-muted">
          <b class="mb-1 block font-medium text-fg">{f.t}</b>{" "}
          {f.d}
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Room for the controls before script shows them. Their layout is fixed so
     the height is known: under 640px a 2x2 grid of stages over a full-width
     button (40 + 4 + 40 + 12 + 40), from 640px one 40px row. */
  .fo-head {
    min-height: 136px;
  }
  @media (min-width: 640px) {
    .fo-head {
      min-height: 40px;
    }
  }
  .fo-step,
  .fo-play {
    min-height: 40px;
    white-space: nowrap;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    background: transparent;
    color: var(--color-muted);
    font-size: 0.875rem;
    cursor: pointer;
  }
  .fo-step[aria-current="step"] {
    background: var(--color-raised);
    color: var(--color-fg);
    border-color: var(--color-subtle);
  }
  .fo-step:focus-visible,
  .fo-play:focus-visible {
    outline: 2px solid var(--color-primary-bright);
    outline-offset: 2px;
  }
  .fo-scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: 8% 10%;
  }
  .fo-lv {
    display: block;
    height: 8px;
    border-radius: 4px;
    background: var(--c);
    transform-origin: left;
    transform: scaleX(0.7);
  }
  .fo-cap {
    position: absolute;
    left: 12px;
    top: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .fo-slate {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 6px;
    text-align: center;
    background: var(--color-raised);
    opacity: 0;
  }
  .fo-slate b {
    font-weight: 500;
    font-size: clamp(1.25rem, 1rem + 1.6vw, 2rem);
    letter-spacing: -0.03em;
  }
  .fo-slate span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .fo-enc {
    position: absolute;
    right: 10px;
    top: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 6px;
    background: color-mix(in oklab, var(--color-ink) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .fo-lamp {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-ok);
  }
  /* State is shown with opacity and lamp colour; the text beside each lamp
     carries the same information, so colour is never the only signal. */
  [data-state="drop"] .fo-scene {
    opacity: 0.2;
  }
  [data-state="drop"] .fo-enc .fo-lamp,
  [data-state="slate"] .fo-enc .fo-lamp {
    background: var(--color-down);
  }
  [data-state="slate"] .fo-slate {
    opacity: 1;
  }
  [data-state="slate"] .fo-scene {
    opacity: 0;
  }
  [data-state="recovered"] .fo-enc .fo-lamp {
    background: var(--color-ok);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-on) .fo-scene,
    :global(.motion-on) .fo-slate {
      transition: opacity 0.3s;
    }
  }
</style>

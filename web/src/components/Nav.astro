---
const links = [
  { href: "/features", label: "Features" },
  { href: "/docs", label: "Docs" },
];
const GITHUB = "https://github.com/rainmanjam/polyemesis";
/* NORMALISED, because this build emits FLAT FILES.
 *
 * Astro.url.pathname is "/features.html" here, not "/features" -- the site
 * builds to dist/features.html and the Worker serves it at /features via
 * html_handling. So the obvious comparison against the link href was false on
 * every page, and the nav marked NOTHING as current: no aria-current for a
 * screen reader, and every link painted text-muted including the one you were
 * already on.
 *
 * It failed silently in the direction that looks fine. A nav where nothing is
 * highlighted reads as a design choice rather than a broken comparison, which
 * is why it survived the move to Workers.
 *
 * Both suffixes are stripped so this holds whichever way the output format is
 * configured later, and "" collapses back to "/" for the home page.
 */
const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/+$/, "") || "/";
const active = (href: string) => here === href || here.startsWith(href + "/");
---

<header class="sticky top-0 z-40 bg-ink/90 backdrop-blur">
  <nav class="wrap flex h-[var(--nav-h)] items-center gap-6 md:gap-9" aria-label="Main">
    <a href="/" class="font-display text-[22px] font-bold tracking-[-0.035em]" aria-label="polyemesis home">
      polyemesis<i class="ml-[3px] inline-block h-[7px] w-[7px] rounded-full bg-accent align-baseline" aria-hidden="true"></i>
    </a>

    <div class="ml-auto hidden items-center gap-7 font-mono text-[13px] md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            aria-current={active(l.href) ? "page" : undefined}
            class:list={["transition-colors", active(l.href) ? "text-fg" : "text-muted hover:text-fg"]}
          >
            {l.label}
          </a>
        ))
      }
      <a href={GITHUB} rel="noopener" class="text-muted transition-colors hover:text-fg">GitHub</a>
      <a
        href="/download"
        aria-current={active("/download") ? "page" : undefined}
        class="btn btn-ghost !px-3.5 !py-2 !font-mono !text-[13px] !font-normal"
      >
        Install polyemesis
      </a>
    </div>

    {/* No JS: a checkbox drives the mobile menu, so it works before hydration
        and keeps this page at zero client-side script. */}
    <input type="checkbox" id="menu" class="peer sr-only md:hidden" />
    <label
      for="menu"
      class="ml-auto cursor-pointer rounded-[2px] border border-line-strong p-2 md:hidden"
      aria-label="Toggle menu"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M2 5h14M2 9h14M2 13h14" stroke-linecap="round"></path>
      </svg>
    </label>
    <div class="absolute left-0 right-0 top-[var(--nav-h)] hidden border-b border-line bg-ink peer-checked:block md:!hidden">
      <div class="wrap flex flex-col gap-1 pb-4 pt-2 font-mono text-[13px]">
        {
          /* The same current-page treatment as the desktop nav. This menu is
             the ONLY navigation on a phone, so leaving it unmarked is the case
             that matters most, not the lesser one. */
          links.map((l) => (
            <a
              href={l.href}
              aria-current={active(l.href) ? "page" : undefined}
              class:list={["py-2.5", active(l.href) ? "text-fg" : "text-muted hover:text-fg"]}
            >
              {l.label}
            </a>
          ))
        }
        <a href={GITHUB} rel="noopener" class="py-2.5 text-muted hover:text-fg">GitHub</a>
        <a
          href="/download"
          aria-current={active("/download") ? "page" : undefined}
          class="btn btn-ghost mt-2 !font-mono !text-[13px] !font-normal"
        >
          Install polyemesis
        </a>
      </div>
    </div>
  </nav>
</header>

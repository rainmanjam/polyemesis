---
/* THE VERSION COMES FROM THE CHANGELOG, NOT FROM THIS FILE. A hand-written
 * version in a marketing page goes stale in silence. The latest release heading
 * in CHANGELOG.md is read at build time (lib/release.ts); if it cannot be read,
 * the line is omitted rather than a guess being printed.
 */
import { latestRelease } from "../lib/release";

const release = latestRelease();
const REPO = "https://github.com/rainmanjam/polyemesis";

/* Four columns, the mockup's arrangement. The landing pages (Multistream, Free
   restream service, Twitch VOD track) are entry points from search rather than
   places a visitor navigates to, so the header nav does not carry them; this is
   where they earn discovery without costing the nav its shape. Each link goes to
   the page itself, not a fragment of an index. */
const cols = [
  {
    title: "Product",
    links: [
      { href: "/features", label: "Features" },
      { href: "/download", label: "Install" },
      { href: "/calculator", label: "Calculator" },
      { href: "/comparison", label: "How it compares" },
    ],
  },
  {
    title: "Learn",
    links: [
      { href: "/docs", label: "Overview" },
      { href: "/docs/audio-routing", label: "Audio routing" },
      { href: "/docs/obs", label: "OBS setup" },
      { href: "/docs/api", label: "HTTP API" },
    ],
  },
  {
    title: "Guides",
    links: [
      { href: "/multistream", label: "Multistream" },
      { href: "/free-restream-service", label: "Free restream service" },
      { href: "/how-to-multistream-from-obs", label: "Multistream from OBS" },
      { href: "/twitch-vod-track", label: "Twitch VOD track" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: REPO, label: "GitHub" },
      { href: `${REPO}/issues`, label: "Issues" },
      { href: "https://hub.docker.com/r/rainmanjam/polyemesis", label: "Docker Hub" },
      { href: `${REPO}/blob/main/LICENSE`, label: "MIT licence" },
      { href: `${REPO}/blob/main/CHANGELOG.md`, label: "Changelog" },
    ],
  },
];
---

<footer class="mt-16 border-t border-line pb-10 pt-11 font-mono text-xs text-muted">
  <div class="wrap">
    <div class="grid grid-cols-2 gap-x-5 gap-y-7 md:grid-cols-4 md:gap-x-8">
      {
        cols.map((c) => (
          <div>
            {/* NOT <h2>: a four-word column label as a heading lands in every
                page's outline between the real headings. A paragraph carries the
                styling and no structural claim. */}
            <p class="mb-3 font-medium text-fg">{c.title}</p>
            <ul class="grid gap-1">
              {c.links.map((l) => (
                <li>
                  {/* inline-block + padding-block: vertical padding on an
                      inline <a> does not grow its hit area, and WCAG 2.2 AA
                      asks for 24px. */}
                  <a
                    href={l.href}
                    class="inline-block py-1 transition-colors hover:text-fg focus-visible:text-fg"
                    rel={l.href.startsWith("http") ? "noopener" : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
              {c.title === "Project" && release && (
                <li>
                  <a
                    href={`${REPO}/releases/tag/v${release.version}`}
                    class="inline-block py-1 transition-colors hover:text-fg focus-visible:text-fg"
                    rel="noopener"
                  >
                    v{release.version} · {release.date}
                  </a>
                </li>
              )}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-9 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-line pt-[18px]">
      <span>polyemesis · open source · self-hosted</span>
      <span>One stream in. Different audio out.</span>
    </div>
    <p class="mt-4 max-w-3xl leading-relaxed">
      polyemesis is not affiliated with or endorsed by YouTube, Twitch, Kick, Rumble, Facebook, Meta, X or Elgato; their names and logos are trademarks of their owners.
    </p>
  </div>
</footer>

---
/* READ FROM GIT, NOT TYPED. A hand-written version in a marketing page is a
 * claim that goes stale in silence, and a stale one is worse than none -- it
 * says "last touched at 0.4" about a project on 0.6.
 *
 * The tag is resolved at build time from the repository the site is built in.
 * If that fails -- a shallow clone, a tarball, no tags -- the whole line is
 * omitted rather than a guess being printed. The build still succeeds; the
 * footer just says less.
 */
import { execSync } from "node:child_process";

let version = "";
try {
  version = execSync("git describe --tags --abbrev=0", {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  }).trim();
} catch {
  version = "";
}

const cols = [
  {
    title: "Product",
    links: [
      { href: "/features", label: "Features" },
      { href: "/comparison", label: "How it compares" },
      { href: "/download", label: "Install" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "/docs", label: "Overview" },
      { href: "/docs#audio-routing", label: "Audio routing" },
      { href: "/docs#start", label: "OBS setup" },  // OBS.md lives in the "Getting it running" group
      { href: "/docs#api", label: "HTTP API" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/rainmanjam/polyemesis", label: "GitHub" },
      { href: "https://github.com/rainmanjam/polyemesis/issues", label: "Issues" },
      { href: "https://hub.docker.com/r/rainmanjam/polyemesis", label: "Docker Hub" },
      { href: "https://github.com/rainmanjam/polyemesis/blob/main/LICENSE", label: "MIT licence" },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="wrap grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div>
      <div class="flex items-center gap-2.5 font-display font-medium">
        <svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true">
          <rect x="1" y="8" width="2.5" height="6" rx="1.25" fill="#5b7fc7" />
          <rect x="5" y="4" width="2.5" height="14" rx="1.25" fill="#5b7fc7" />
          <rect x="9" y="6.5" width="2.5" height="9" rx="1.25" fill="#3ecf6d" />
          <rect x="13" y="2" width="2.5" height="18" rx="1.25" fill="#3ecf6d" />
          <rect x="17" y="7" width="2.5" height="8" rx="1.25" fill="#45b5d0" />
        </svg>
        polyemesis
      </div>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-subtle">
        A self-hosted restreaming server with per-destination multichannel audio
        routing. One static binary, MIT licensed.
      </p>
      {/* "IS THIS MAINTAINED" IS THE QUESTION THAT STOPS THE DOWNLOAD, and the
          site answered it nowhere. Two reviews flagged it independently, from
          different briefs: one as a trust signal, one as project-continuity
          risk.

          The version is read from the release at build time rather than typed,
          because a hand-written version is a claim that goes stale silently --
          and a stale one is worse than none. */}
      {version && (
      <p class="mt-4 text-sm text-subtle">
        <a
          href={`https://github.com/rainmanjam/polyemesis/releases/tag/${version}`}
          class="inline-block py-1 font-mono text-muted transition-colors hover:text-fg"
          rel="noopener"
        >{version}</a>
        <span class="mx-1.5 opacity-40">·</span>
        <a
          href="https://github.com/rainmanjam/polyemesis/blob/main/CHANGELOG.md"
          class="inline-block py-1 text-muted transition-colors hover:text-fg"
          rel="noopener"
        >Changelog</a>
      </p>
      )}
    </div>
    {
      cols.map((c) => (
        <div>
          {/* NOT <h2>. These are four-word column labels -- "Product", "Docs",
              "Project" -- and as headings they landed in every page's outline
              between the real content headings, so a screen-reader user
              navigating by heading met three footer labels on every page. A
              paragraph carries the same styling and no structural claim. */}
          <p class="font-mono text-[11px] uppercase tracking-wider text-subtle">{c.title}</p>
          {/* space-y-1 rather than space-y-2, because each link below now carries
              4px of vertical padding. The gap between two of them is unchanged
              at 8px; what changed is that the 8px belongs to the tap targets
              instead of to the space between them. */}
          <ul class="mt-3 space-y-1">
            {c.links.map((l) => (
              <li>
                {/* inline-block + padding-block, because an inline <a> at this
                    size measures 18px tall and WCAG 2.2 AA asks for 24x24.
                    Vertical padding on an INLINE element does not grow its hit
                    area -- inline-block is what makes the 4px count. */}
                <a
                  href={l.href}
                  class="inline-block py-1 text-sm text-muted transition-colors hover:text-fg"
                  rel={l.href.startsWith("http") ? "noopener" : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line/60">
    <div class="wrap flex flex-wrap items-center justify-between gap-3 py-5 font-mono text-[11px] text-subtle">
      <span>MIT licensed. Run it on your own hardware.</span>
      <span>Not affiliated with YouTube, Twitch, Kick or Meta.</span>
    </div>
  </div>
</footer>

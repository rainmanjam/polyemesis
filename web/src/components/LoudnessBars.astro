---
/* Three destinations, animated, at the levels that were actually measured.
 *
 * The section this sits in argues "these three numbers differ, therefore the
 * routing is real". A static screenshot makes that argument once; a meter that
 * moves makes it continuously, because the eye reads a moving bar as a live
 * signal and a still one as a claim.
 *
 * WHAT IS REAL AND WHAT IS NOT, because this page's whole value is that the
 * distinction is stated. The three LUFS figures and the track sets are the
 * measured capture — the same numbers as the screenshot beside this. The
 * per-frame WOBBLE is not measured: it is a few tenths of a dB of movement so
 * the bars read as programme rather than as a bar chart. No claim is made that
 * this is a live feed, and the caption says so.
 *
 * Bar length maps LUFS to width against a -40..0 scale, so "louder" is longer
 * and the three bars are comparable at a glance — which is the entire point of
 * putting them side by side.
 */

const FLOOR = -40; // dBFS at which a bar reads empty

/* These MUST match scripts/seed_demo.go, which generates the capture beside
 * this. They did not: this was first written from the hero's illustrative
 * arrangement, which names an "Archive" destination taking "all six" tracks.
 * Neither exists in the capture — and worse, "all six" was shown 6.3 LU quieter
 * than a two-track destination, which is impossible for a superset and is
 * exactly the arithmetic a broadcast engineer checks first. */
const DESTS = [
  { name: "YouTube", lufs: -12.6, tracks: "01 + 02 + 03", tone: "live" },
  { name: "Twitch", lufs: -14.0, tracks: "01 + 03", tone: "live" },
  { name: "Podcast", lufs: -18.9, tracks: "01", tone: "meter" },
] as const;

const pct = (l: number) => Math.max(0, Math.min(100, ((l - FLOOR) / -FLOOR) * 100));
---

<div class="card overflow-hidden">
  <div class="flex items-center gap-2 border-b border-line px-4 py-2.5">
    <span class="size-1.5 rounded-full bg-live"></span>
    <span class="font-mono text-[11px] text-subtle">
      loudness per destination · EBU R128, measured after routing
    </span>
  </div>

  <div class="space-y-3 p-5 sm:p-6">
    {
      DESTS.map((d, i) => (
        <div class="grid grid-cols-[5.5rem_1fr_4.5rem] items-center gap-3 sm:gap-4">
          <span class="text-[13px] text-fg">{d.name}</span>

          <div class="relative h-2.5 overflow-hidden rounded-full bg-ink">
            {/* -16 LUFS, not -23. -23 is EBU R128 *broadcast* delivery; no
                streaming platform here normalises to it, and docs/AUDIO-ROUTING.md
                says loudnorm defaults to -16 "the figure the streaming platforms
                expect". Marking -23 put all three bars on the loud side of a line
                nobody in this workflow aims at. */}
            <span
              class="absolute inset-y-0 z-10 w-px bg-line-strong"
              style={`left: ${pct(-16)}%`}
              aria-hidden="true"
            />
            <div
              class:list={["loud-bar h-full rounded-full", d.tone === "live" ? "bg-live/70" : "bg-meter/70"]}
              style={`width: ${pct(d.lufs)}%; animation-delay: -${(i * 0.83).toFixed(2)}s; animation-duration: ${(3.1 + i * 0.37).toFixed(2)}s`}
            />
          </div>

          <span class="text-right font-mono text-[13px] tabular-nums text-fg">
            {d.lufs.toFixed(1)}
          </span>
        </div>
      ))
    }

    {/* THE GRATICULE. Without it these are three bars of arbitrary length; with
        it they are a reading. A broadcast engineer looks for the scale before
        the value, and a meter that does not show what it is measured against
        is a picture of a meter.

        The stops are the ones this workflow actually aims at: the -40 floor
        the bars are normalised to, -16 where loudnorm targets, and 0. The
        intermediate marks are unlabelled so the row stays a scale rather than
        becoming a second data display. */}
    <div class="grid grid-cols-[5.5rem_1fr_4.5rem] items-center gap-3 pt-0.5 sm:gap-4">
      <span aria-hidden="true" />
      <div class="relative h-3" aria-hidden="true">
        {[-40, -30, -20, -16, -10, -5, 0].map((db) => (
          <span
            class:list={[
              "absolute top-0 w-px",
              db === -16 || db === -40 || db === 0 ? "h-1.5 bg-line-strong" : "h-1 bg-line",
            ]}
            style={`left: ${pct(db)}%`}
          />
        ))}
        {[-40, -16, 0].map((db) => (
          <span
            class="absolute top-2 -translate-x-1/2 font-mono text-[9px] leading-none text-subtle"
            style={`left: ${pct(db)}%`}
          >
            {db}
          </span>
        ))}
      </div>
      <span class="text-right font-mono text-[9px] leading-none text-subtle">LUFS</span>
    </div>

    <div class="grid grid-cols-[5.5rem_1fr_4.5rem] gap-3 pt-1 sm:gap-4">
      <span class="font-mono text-[10px] uppercase tracking-wider text-subtle">tracks</span>
      <span class="font-mono text-[10px] text-subtle">
        {DESTS.map((d) => `${d.name.toLowerCase()} ${d.tracks}`).join("  ·  ")}
      </span>
      <span class="text-right font-mono text-[10px] text-subtle">LUFS</span>
    </div>
  </div>
</div>

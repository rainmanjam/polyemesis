<script>
  /* The loader: ~1 kB. Waits until the hero is near the viewport, then until
     the browser is idle after load, then imports the controller. Everything
     heavy (the controller, Three.js) is behind that import(), so none of it
     is fetched before first paint and none of it is preloaded. */
  const root = document.querySelector<HTMLElement>("[data-signal-path]");
  if (root) {
    const start = () => {
      import("../scripts/signal-path/controller.js")
        .then((m) => m.init())
        .catch((error) => {
          // The HTML diagram is complete without the module; say so and carry on.
          console.info("Signal path animation unavailable, showing the static diagram.", error);
        });
    };
    const whenIdle = () => {
      const go = () => ("requestIdleCallback" in window ? requestIdleCallback(start, { timeout: 1500 }) : setTimeout(start, 200));
      if (document.readyState === "complete") go();
      else addEventListener("load", go, { once: true });
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            whenIdle();
          }
        },
        { rootMargin: "200px" },
      );
      io.observe(root);
    } else {
      whenIdle();
    }
  }
</script>

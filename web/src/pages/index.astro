---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import MixMatrix from "../components/MixMatrix.astro";
import SpecStrip from "../components/SpecStrip.astro";
import LoudnessBars from "../components/LoudnessBars.astro";
import HeroRouting from "../components/HeroRouting.astro";
import { Picture } from "astro:assets";
import meters from "../assets/shots/04-meters.png";
/* Counted, never typed. A literal "23 documents" in the CTA below is a claim
 * that goes stale the first time somebody publishes a document, and nothing
 * would fail — the page would simply be wrong about the thing it is inviting
 * you to read. docs.mjs is the allowlist, so it is also the count. */
import { PUBLISHED } from "../data/docs.mjs";

const features = [
  {
    t: "Video is copied, not re-encoded — unless you ask for a rendition",
    d: "Without a rendition every destination gets -c:v copy, so CPU cost is nearly independent of resolution. Only audio is decoded, mixed and re-encoded to AAC.",
  },
  {
    t: "Shared renditions for the platforms that refuse your source",
    d: "One encode feeds every destination that selects it, ref-counted so an unused tier costs nothing — and it re-encodes video only, so audio still routes per destination.",
  },
  {
    t: "One port per protocol, many programmes",
    d: "Sources are told apart by a publish token — supplied in OBS's Stream Key field on RTMP, and as the streamid on SRT — so a second programme never means opening a second port either way. RTMP is still the single-track fallback: one stereo pair on anything below FFmpeg 7.1.",
  },
  {
    t: "Live meters on every channel of every track",
    d: "How you verify the clean track really is clean before you go live, rather than after the VOD is published.",
  },
  {
    t: "Chat moderation across five platforms",
    d: "Delete everywhere, hide on Facebook, ban and timeout on YouTube, Twitch and Kick — and a moderator card showing what one person said across every platform at once.",
  },
  {
    t: "Failover with a standby ingest and a slate",
    d: "A source selector that switches without restarting a single destination. Off by default: with it off the pipeline is byte-for-byte what it was before.",
  },
];
---

{/* Title: problem first, brand second, and under 60 characters so a search
    result does not truncate it mid-clause. The previous one led with the
    product name and the phrase "per-destination audio routing", which is the
    vocabulary of someone who has already found the project — #143's finding was
    that the person with this problem searches for the problem. */}
<Base
  title="Multistream, a different mix per platform — polyemesis"
  description="Self-hosted multistreaming with a different audio mix per platform. One SRT ingest carries OBS's split tracks — send the clean feed where music gets muted."
  path="/"
>
  {/* ---------------------------------------------------------------- hero */}
  <section class="relative overflow-hidden border-b border-line">
    <div class="signal-grid absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative grid gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-28">
      <div class="max-w-xl">
        {/* THE DOT IS GONE, and it was the smallest of the accent findings and
            the clearest. A filled green disc is this product's LIVE indicator —
            it means a destination is up, and it means that in the panel to the
            right of this chip, in the meters on /features, and in the
            application itself. Beside the words "MIT licensed" it means
            nothing, and a status light that means nothing anywhere teaches a
            reader to stop reading status lights everywhere.

            Nothing replaces it. A grey dot would be the same decoration with
            the meaning drained out; the chip's border already says "this is a
            label" without help. */}
        <span class="chip rise rise-1">MIT licensed · self-hosted</span>

        {/* "One stream in. A different mix out of each." — the shape the social
            card settled on, and it is a better opening than the old headline for
            one reason: it states the trade in the reader's terms (what they send,
            what comes out) rather than in the product's (six tracks, platforms).
            The old one named OBS in the first three words, which excludes every
            reader who arrived from a hardware encoder. */}
        {/* THREE LINES, AND docs/DESIGN-SYSTEM.md ASKS FOR TWO. This is the one
            place the design note could not be executed as written, so the
            measurement is recorded here rather than left for the next person to
            rediscover by trying it.

            The headline is 42 characters. This column is max-w-xl (576px) and
            the type is 3.4rem, which measures ~0.47em per character in Space
            Grotesk Bold — about 24 characters per line. Two lines therefore
            needs the longest of them to be ≤24 characters, and the best split
            at a word boundary is 26 ("One stream in. A different" / "mix out of
            each."). It does not fit at any break, and it gets worse going down:
            at the lg breakpoint itself, 1024px, the copy cell is 493px and a
            two-line headline would need the type dropped to ~2.3rem — which
            trades the "large type" half of the same finding for the "two lines"
            half.

            Rendered at 1440px, the two-line version wrapped to three anyway and
            left "each." alone on the third — an orphan the eye reads as a
            mistake. A composed break beats an accidental one, so the breaks
            stay, one clause per line.

            WHAT WOULD ACTUALLY FIX IT is in the report accompanying this
            change: every site the design note draws from — Linear, Modal, Neon
            — has a SINGLE-COLUMN hero, where the headline gets the full 1240px
            and two lines is free. The two-column hero is what makes the rule
            unreachable, not the headline.

            THE HIGHLIGHT IS THE ACCENT NOW, NOT THE LIVE COLOUR. "different
            mix" was painted --color-live, which this system reserves for a
            destination that is actually up — the same reservation the amber
            rule at the top of global.css states for the signal path and that
            check-build enforces. Green in a headline spends the colour that
            makes a green dot legible in the panel eighteen inches to the right.
            The accent is what a headline is allowed to use, and this is one of
            the three places docs/DESIGN-SYSTEM.md gives it: the announcement
            bar, half the headline, the primary CTA. */}
        <h1 class="rise rise-2 mt-6 text-balance text-4xl font-bold leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
          One stream in.<br />
          A <span class="text-primary-bright">different mix</span><br />
          out of each.
        </h1>

        <p class="rise rise-3 mt-6 text-pretty text-lg leading-relaxed text-muted">
          Self-hosted restreaming with per-destination audio routing. Video is
          copied, not re-encoded. Every live platform takes exactly one stereo
          pair, so normally you pick one mix for everyone — polyemesis ingests
          once over SRT and lets you choose, per destination, which tracks get
          summed into the feed it receives.
        </p>

        {/* THE FIRST THING THE HERO OFFERS IS THE COMMAND, because that is
            literally what the visitor is about to do: this ships as one static
            binary or one container and is installed from a shell. A hero whose
            primary control is a signup-shaped button describes a product that
            does not exist here, and the strip that used to sit under the buttons
            said the same thing in 12px grey — unreadable, uncopyable, and
            already drifted from README.md (no `--name`, no `:latest`, no 1935).

            COPIED VERBATIM FROM README.md's "Try it". An invented invocation is
            the fastest way to be caught by the one audience guaranteed to paste
            it into a terminal, and a command that half-works is worse than none:
            the container it creates has fixed port mappings and has to be
            destroyed to fix them. */}
        {/* ABOVE THE COMMAND, and only just. The command is still the hero's
            primary control -- this ships as a container and that is what a
            visitor is about to paste. But "how much bandwidth does this need"
            is the question asked before the install, not after it, and a
            visitor who cannot answer it does not run the command at all. So it
            sits directly above, as a link rather than a second button
            competing with the copy control. */}
        {/* ONE ENTRY MOMENT FOR THE WHOLE CONTROL GROUP, which is what this
            wrapper is for and its only job.

            The three blocks inside it — the calculator link, the command, the
            two buttons — used to enter separately: two of them shared rise-3
            with the subhead (arriving from three places on the screen at the
            same instant, which is a flicker rather than a sequence), one had
            rise-4, and the buttons had no rise at all, so the single most
            important control in the hero was the one element that did not
            participate in the page's arrival.

            They are one thing to a reader — "here is how you start" — so they
            are one thing to the cascade. The hero now reads top to bottom in
            four steps and hands off to the product panel on the fifth. */}
        <div class="rise rise-4">
          {/* A LINK, WHICH IS WHAT THE COMMENT ABOVE SAYS IT IS. It was written
              `class="btn btn-ghost"` — the same outlined button as "Install
              guide" thirty lines below — so the hero shipped three buttons and a
              rule about two, and the reasoning directly above it described a
              control that did not exist. docs/DESIGN-SYSTEM.md's website section
              is explicit: one filled primary and one outlined secondary, never
              more, because a hero with three equal-weight controls has no primary
              action at all. The rule the code contradicted is the one that was
              right, so the code moved. */}
          <div class="mt-8">
            <a
              href="/calculator"
              class="text-sm text-fg underline decoration-line underline-offset-4 transition-colors hover:decoration-primary-bright"
            >
              Bandwidth calculator →
            </a>
            {/* Under the button, not beside it. Inline, the sentence wrapped
                around the button's right edge at every width between a phone and
                a wide desktop -- a ragged second line starting under the middle
                of a control reads as a caption that lost its anchor. Below it,
                the line breaks where the column does, like every other paragraph
                on the page. */}
            <p class="mt-3 max-w-md text-sm leading-relaxed text-subtle">
              What one stream to several platforms costs your uplink, per month.
            </p>
          </div>

          <div class="mt-6">
            <CodeBlock
              label="docker"
              code={`docker run -d --name polyemesis \\
  -p 8080:8080 -p 6000:6000/udp -p 1935:1935 \\
  -v polyemesis-data:/data \\
  rainmanjam/polyemesis:latest`}
            />
            <p class="mt-3 text-sm leading-relaxed text-subtle">
              Then open <span class="font-mono text-fg">http://localhost:8080</span> and set an
              admin password on the first-run screen. Note the
              <span class="font-mono text-fg">/udp</span> on 6000 — SRT is UDP, and omitting the
              suffix is the classic reason an ingest silently receives nothing.
              1935 is published even if you plan to use SRT: a container's port
              map is frozen when it is created, so adding RTMP later means
              recreating the container.
            </p>
          </div>

          {/* THE DOCS ARE THE CALL TO ACTION, not a footer link. Nobody signs up
              for a self-hosted binary; they decide whether they can operate it,
              and the only thing that answers that is the documentation. So the
              primary control is the quickstart and the secondary is the install
              guide — both rendered from the repository's own files, so neither can
              promise something the software does not do. */}
          {/* The tertiary link is NOT accent-coloured, and this is the accent
              audit applied at the one place it costs something. It was
              text-primary-bright, sitting 12px from the filled primary button in
              a lighter shade of the same colour — two controls, one hue, no
              hierarchy between them. It keeps every affordance that matters (the
              arrow, the underline on hover, a real focus ring) and gains the
              accent only on hover, so approaching it is what lights it up. */}
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a href="/docs/quickstart" class="btn btn-primary">Read the quickstart</a>
            <a href="/docs/install" class="btn btn-ghost">Install guide</a>
            <a
              href="#matrix"
              class="inline-block py-2 text-sm text-fg transition-colors hover:text-primary-bright hover:underline"
            >
              See the routing →
            </a>
          </div>
          {/* "Pre-release, one maintainer, MIT — where it loses is written down
              too" USED TO BE HERE, in 14px --color-subtle under the buttons: the
              least prominent line in the hero, carrying the most important thing
              a stranger can be told about this project. It is now the
              announcement bar (components/Announce.astro), which is the first
              line of every page — so it is said once, at the top, rather than
              twice on the page a reader is least likely to have scrolled. */}
          <p class="mt-3 text-sm text-subtle">First stream in about five minutes.</p>
        </div>
      </div>

      {/* The hero visual is the signal path itself, not a screenshot floating
          at an angle. Both design passes reached that independently: the
          product's architecture IS the argument, so the page opens with it.

          It is now the ROUTING TABLE rather than the track fan-out. Same claim,
          told from the other end: the old panel showed six tracks going in and
          left the reader to infer that the outputs differed, while this one
          shows four destinations whose mixes visibly differ and whose loudness
          differs because of it. The fan-out survives further down the page in
          MixMatrix, where there is room to be explicit about it. */}
      {/* Centred against the copy rather than pinned to the top. The panel is
          shorter than the text column, and top-aligning left a hole under it
          that read as a missing element. */}
      <div class="relative flex items-center">
        {/* LAST IN THE CASCADE, on purpose. It shared rise-3 with the subhead
            and the calculator block, so the product panel — the thing the whole
            hero is an argument for — arrived in the middle of the copy instead
            of after it. Landing it last makes the page-load one sentence: this
            is what it is, this is how you start, and here it is running. */}
        <div class="rise rise-5 w-full">
          <HeroRouting />
        </div>
      </div>
    </div>
  </section>

  <SpecStrip />

  {/* ------------------------------------------------------------- problem */}
  <section class="wrap py-20 sm:py-24" data-reveal>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 class="mt-3 text-balance text-3xl font-medium">
          You have six tracks. Every platform will take one stereo pair.
        </h2>
      </div>
      <div class="space-y-4 text-pretty leading-relaxed text-muted">
        <p>
          You run OBS with split audio tracks. Track 1 is the full mix
          including copyrighted music, track 2 is the clean feed without it,
          track 3 is your microphone.
        </p>
        <p>
          Every live platform accepts exactly one stereo pair. So
          normally you must choose one mix for everyone — and risk a claim on
          YouTube or a muted VOD on Twitch, or send both a
          broadcast with no music — or multistream from the stream PC: several
          encoders and several uploads off one machine and one connection.
        </p>
        <p class="text-fg">
          polyemesis ingests once and lets you pick, per destination, which
          tracks get summed into the stereo feed that destination receives.
          YouTube gets the clean mix. Your local archive keeps everything. Your
          Discord restream keeps the mic hot. On Twitch it goes one step further — the broadcast can carry the music bed while a separate archive track leaves it out, from the same upload. That last one is Twitch Enhanced Broadcasting, and it <strong>needs a supported GPU</strong>: Twitch refuses to negotiate it otherwise, so on a headless server the destination publishes to the ordinary ingest instead and says so.
        </p>
      </div>
    </div>
  </section>

  <MixMatrix />

  {/* --------------------------------------------------------------- proof */}
  <section class="border-y border-line bg-surface/30 py-20 sm:py-24" data-reveal>
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">Proof, not a diagram</p>
        <h2 class="mt-3 text-balance text-3xl font-medium">
          Three destinations, three different loudness readings, one ingest.
        </h2>
        <p class="mt-4 text-pretty leading-relaxed text-muted">
          One three-track source feeds all three destinations. The meters read
          <span class="font-mono text-fg">−12.6</span>,
          <span class="font-mono text-fg">−14.0</span> and
          <span class="font-mono text-fg">−18.9&nbsp;LUFS</span> because each
          was sent a different set of tracks — loudness is measured per
          destination, after routing, on the programme that destination
          actually receives.
        </p>
        <p class="mt-3 text-pretty text-sm leading-relaxed text-subtle">
          This capture is a different source from the example above: track 1 is
          the host mic, track 2 the music bed, track 3 the co-host. So Twitch's
          <span class="font-mono">01&nbsp;+&nbsp;03</span> is the mix with the
          music left out, and it reads quieter for exactly that reason.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <LoudnessBars />
        <figure>
          {/* Imported rather than referenced by URL: public/ is copied
              verbatim, so a path there cannot produce the smaller variants a
              phone should be getting. The widths and sizes match features.astro
              -- this figure sits in the same .wrap grid at the same ratio. */}
          <Picture
            src={meters}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[420, 690, 960, 1440]}
            sizes="(min-width: 1024px) 690px, calc(100vw - 2.5rem)"
            alt="polyemesis audio meters: three destinations showing −12.6, −14.0 and −18.9 LUFS from one ingest, each measured after its own routing"
            loading="lazy"
            decoding="async"
            class="w-full rounded-token border border-line"
          />
          <figcaption class="mt-3 font-mono text-[11px] text-subtle">
            A capture from a running install. The bars on the left carry the same
            measured figures; their movement is illustrative, the numbers are not.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ features */}
  <section class="wrap py-20 sm:py-24" data-reveal>
    <div class="max-w-2xl">
      <p class="eyebrow">What else it does</p>
      <h2 class="mt-3 text-balance text-3xl font-medium">
        The rest of it is a broadcast server.
      </h2>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden rounded-token border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="bg-surface p-6">
            <h3 class="text-pretty text-[15px] font-medium leading-snug text-fg">{f.t}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{f.d}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-subtle">
      <a href="/features" class="inline-block py-1 text-fg transition-colors hover:text-primary-bright hover:underline">The full list →</a>
    </p>
  </section>

  {/* ---------------------------------------------------- how it is built */}
  <section class="border-t border-line bg-surface/30 py-20 sm:py-24" data-reveal>
    <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">How it is built</p>
        <h2 class="mt-3 text-balance text-3xl font-medium">Decisions you can rely on.</h2>
        <p class="mt-4 text-sm leading-relaxed text-subtle">
          Four choices that shape everything else. Each one was made on purpose
          and is held to release after release.
        </p>
      </div>
      <dl class="divide-y divide-line border-y border-line">
        {
          [
            ["SRT carries every audio track", "One ingest accepting up to 32 tracks — six is what OBS sends — and each destination takes the mix you route to it. It works on any FFmpeg above the floor and it is the path that is operated daily, so the feature this product exists for is the one with the most road behind it. RTMP sits alongside it as the single-track fallback; Enhanced RTMP carries more on FFmpeg 7.1+, though an OBS-as-publisher run has not been confirmed."],
            ["Routing audio never touches your picture", "Video is stream-copied end to end, so the frames a platform receives are the frames your encoder made, and the cost of routing scales with audio rather than resolution. Shared renditions re-encode video only when you ask for one, and the cost of that encode is shown before it starts."],
            ["One binary, one config file", "No database to run, no broker, no container required. It installs as a systemd service on hardware you control, with no hosted service behind it and no per-destination pricing — the only connections it makes are the ones you configure."],
            ["Built for the operator at the desk", "One account and full control — no permission model to configure and none to get wrong. Live ingest, destination and process state are on one screen, and the routing you compiled is shown as the FFmpeg filter graph it became."],
          ].map(([t, d]) => (
            <div class="py-4">
              <dt class="text-[15px] font-medium text-fg">{t}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-muted">{d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------- who it is for */}
  {/* NAMING WHO SHOULD NOT USE THIS is the point of the second column, and it is
      the reason this section exists. Both reviews said the same thing from
      different angles: the site never states its own limits, and a product that
      cannot say who it is wrong for reads as marketing.

      It sits immediately before the call to action deliberately. A reader who
      recognises themselves in the right-hand column should leave here rather
      than install, discover the mismatch, and conclude the software is bad at
      something it never claimed. */}
  <section class="border-t border-line py-20 sm:py-24" data-reveal>
    <div class="wrap">
      <h2 class="text-balance text-3xl font-medium">Is this for you?</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <div class="card p-6">
          {/* text-fg, and it was `text-accent` — a class Tailwind never
              generated, because this theme defines no --color-accent (the
              accent token is --color-primary). It therefore emitted no rule at
              all and the label inherited body colour, which happens to BE
              --color-fg: the label has always rendered exactly as it does on
              this line, and the difference from its "Not built for" sibling was
              an accident that looked deliberate.

              Left at fg rather than given the accent for real. The two columns
              are a pair and the difference between them is emphasis, not
              category — spending the accent here would put a fourth saturated
              thing on a page whose accent budget is the announcement bar, half
              the headline and the primary CTA. */}
          <p class="font-mono text-[11px] uppercase tracking-wider text-fg">Built for</p>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>You already run a server, or are willing to. A VPS is enough.</li>
            <li>You stream to more than one platform and want each to hear something different.</li>
            <li>Your VODs get muted, and a music-free second track would fix it.</li>
            <li>You are comfortable with a config file and a terminal.</li>
          </ul>
        </div>
        <div class="card p-6">
          <p class="font-mono text-[11px] uppercase tracking-wider text-subtle">Not built for</p>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>
              You want somebody else to run it. There is no hosted tier, and no
              plan for one. Hosted services exist and are good at it —{" "}
              <a href="/free-restream-service" class="underline decoration-line underline-offset-4 hover:text-fg">what you trade either way</a>{" "}
              is written out.
            </li>
            <li>You need a browser studio, guest invites, or cloud recording storage.</li>
            <li>You want support with an SLA. This is MIT software maintained in the open.</li>
            <li>One platform, one mix. You do not need any of this.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- cta */}
  <section class="wrap py-20 sm:py-28" data-reveal>
    <div class="card relative overflow-hidden px-6 py-14 text-center sm:px-12">
      <div class="signal-grid absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="text-balance text-3xl font-medium sm:text-4xl">
          One binary. One config file. Your hardware.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-pretty leading-relaxed text-muted">
          No account, nothing phoning home, no hosted tier to graduate to. Pull the
          image or download the binary and point OBS at it.
        </p>

        {/* THREE DOCUMENTS, NOT A BUTTON. The decision a reader is making here
            is "can I run and operate this on my own box", and a button labelled
            "Install polyemesis" answers a question nobody asked — the install
            page is one click further on, and it is still here.

            Each card is a real file in docs/, rendered at build time from the
            same commit as the code, so none of these can describe a version of
            the product that does not exist. The blurbs are README.md's own
            words for the same three documents. */}
        <div class="mt-9 grid gap-px overflow-hidden rounded-token border border-line bg-line text-left sm:grid-cols-3">
          {
            [
              ["/docs/quickstart", "Quickstart", "QUICKSTART.md", "First stream in about five minutes."],
              ["/docs/install", "Install", "INSTALL.md", "Per-platform, including a too-old FFmpeg."],
              ["/comparison", "Comparison", "COMPARISON.md", "An honest comparison, including the parts where polyemesis loses."],
            ].map(([href, title, file, blurb]) => (
              <a href={href} class="group block bg-surface p-5 transition-colors hover:bg-raised">
                <p class="flex flex-wrap items-baseline gap-x-2.5">
                  <span class="text-[15px] font-medium text-fg group-hover:text-primary-bright">{title}</span>
                  <span class="font-mono text-[11px] text-subtle">{file}</span>
                </p>
                <p class="mt-2 text-sm leading-relaxed text-muted">{blurb}</p>
              </a>
            ))
          }
        </div>

        <div class="mt-7 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
          <a href="/download" class="text-fg transition-colors hover:text-primary-bright hover:underline">Install options →</a>
          <a href="/docs" class="text-fg transition-colors hover:text-primary-bright hover:underline">All {PUBLISHED.length} documents →</a>
          <a
            href="https://github.com/rainmanjam/polyemesis"
            rel="noopener"
            class="text-fg transition-colors hover:text-primary-bright hover:underline">Read the source →</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import MixMatrix from "../components/MixMatrix.astro";
import SpecStrip from "../components/SpecStrip.astro";
import LoudnessBars from "../components/LoudnessBars.astro";
import HeroRouting from "../components/HeroRouting.astro";
import { Picture } from "astro:assets";
import meters from "../assets/shots/04-meters.png";

const features = [
  {
    t: "Video is copied, not re-encoded — unless you ask for a rendition",
    d: "Without a rendition every destination gets -c:v copy, so CPU cost is nearly independent of resolution. Only audio is decoded, mixed and re-encoded to AAC.",
  },
  {
    t: "Shared renditions for the platforms that refuse your source",
    d: "One encode feeds every destination that selects it, ref-counted so an unused tier costs nothing — and it re-encodes video only, so audio still routes per destination.",
  },
  {
    t: "One port per protocol, many programmes",
    d: "Sources are told apart by a publish token — supplied in OBS's Stream Key field on RTMP, and as the streamid on SRT — so a second programme never means opening a second port either way. RTMP is still the single-track fallback: one stereo pair on anything below FFmpeg 7.1.",
  },
  {
    t: "Live meters on every channel of every track",
    d: "How you verify the clean track really is clean before you go live, rather than after the VOD is published.",
  },
  {
    t: "Chat moderation across five platforms",
    d: "Delete everywhere, hide on Facebook, ban and timeout on YouTube, Twitch and Kick — and a moderator card showing what one person said across every platform at once.",
  },
  {
    t: "Failover with a standby ingest and a slate",
    d: "A source selector that switches without restarting a single destination. Off by default: with it off the pipeline is byte-for-byte what it was before.",
  },
];
---

{/* Title: problem first, brand second, and under 60 characters so a search
    result does not truncate it mid-clause. The previous one led with the
    product name and the phrase "per-destination audio routing", which is the
    vocabulary of someone who has already found the project — #143's finding was
    that the person with this problem searches for the problem. */}
<Base
  title="Multistream, a different mix per platform — polyemesis"
  description="Self-hosted multistreaming with a different audio mix per platform. One SRT ingest carries OBS's split tracks — send the clean feed where music gets muted."
  path="/"
>
  {/* ---------------------------------------------------------------- hero */}
  <section class="relative overflow-hidden border-b border-line">
    <div class="signal-grid absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative grid gap-12 py-20 lg:grid-cols-[1.05fr_0.95fr] lg:py-28">
      <div class="max-w-xl">
        <span class="chip rise rise-1">
          <span class="size-1.5 rounded-full bg-live"></span>
          MIT licensed · self-hosted
        </span>

        {/* "One stream in. A different mix out of each." — the shape the social
            card settled on, and it is a better opening than the old headline for
            one reason: it states the trade in the reader's terms (what they send,
            what comes out) rather than in the product's (six tracks, platforms).
            The old one named OBS in the first three words, which excludes every
            reader who arrived from a hardware encoder. */}
        <h1 class="rise rise-2 mt-6 text-balance text-4xl font-bold leading-[1.08] sm:text-5xl lg:text-[3.4rem]">
          One stream in.<br />
          A <span class="text-live">different mix</span><br />
          out of each.
        </h1>

        <p class="rise rise-3 mt-6 text-pretty text-lg leading-relaxed text-muted">
          Self-hosted restreaming with per-destination audio routing. Video is
          copied, not re-encoded. Every live platform takes exactly one stereo
          pair, so normally you pick one mix for everyone — polyemesis ingests
          once over SRT and lets you choose, per destination, which tracks get
          summed into the feed it receives.
        </p>

        <div class="rise rise-4 mt-8 flex flex-wrap gap-3">
          <a href="/download" class="btn btn-primary">Install it</a>
          <a href="#matrix" class="btn btn-ghost">See the routing →</a>
        </div>

        <p class="mt-5 font-mono text-xs text-subtle">
          docker run -d -v polyemesis-data:/data -p 8080:8080 -p 6000:6000/udp rainmanjam/polyemesis
        </p>
      </div>

      {/* The hero visual is the signal path itself, not a screenshot floating
          at an angle. Both design passes reached that independently: the
          product's architecture IS the argument, so the page opens with it.

          It is now the ROUTING TABLE rather than the track fan-out. Same claim,
          told from the other end: the old panel showed six tracks going in and
          left the reader to infer that the outputs differed, while this one
          shows four destinations whose mixes visibly differ and whose loudness
          differs because of it. The fan-out survives further down the page in
          MixMatrix, where there is room to be explicit about it. */}
      {/* Centred against the copy rather than pinned to the top. The panel is
          shorter than the text column, and top-aligning left a hole under it
          that read as a missing element. */}
      <div class="relative flex items-center">
        <div class="rise rise-3 w-full">
          <HeroRouting />
        </div>
      </div>
    </div>
  </section>

  <SpecStrip />

  {/* ------------------------------------------------------------- problem */}
  <section class="wrap py-20 sm:py-24" data-reveal>
    <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">The problem</p>
        <h2 class="mt-3 text-balance text-3xl font-medium">
          You have six tracks. Every platform will take one stereo pair.
        </h2>
      </div>
      <div class="space-y-4 text-pretty leading-relaxed text-muted">
        <p>
          You run OBS with split audio tracks. Track 1 is the full mix
          including copyrighted music, track 2 is the clean feed without it,
          track 3 is your microphone.
        </p>
        <p>
          Every live platform accepts exactly one stereo pair. So
          normally you must choose one mix for everyone — and risk a claim on
          YouTube or a muted VOD on Twitch, or send both a
          broadcast with no music — or multistream from the stream PC: several
          encoders and several uploads off one machine and one connection.
        </p>
        <p class="text-fg">
          polyemesis ingests once and lets you pick, per destination, which
          tracks get summed into the stereo feed that destination receives.
          YouTube gets the clean mix. Your local archive keeps everything. Your
          Discord restream keeps the mic hot. On Twitch it goes one step further — the broadcast can carry the music bed while a separate archive track leaves it out, from the same upload. That last one is Twitch Enhanced Broadcasting, and it <strong>needs a supported GPU</strong>: Twitch refuses to negotiate it otherwise, so on a headless server the destination publishes to the ordinary ingest instead and says so.
        </p>
      </div>
    </div>
  </section>

  <MixMatrix />

  {/* --------------------------------------------------------------- proof */}
  <section class="border-y border-line bg-surface/30 py-20 sm:py-24" data-reveal>
    <div class="wrap">
      <div class="max-w-2xl">
        <p class="eyebrow">Proof, not a diagram</p>
        <h2 class="mt-3 text-balance text-3xl font-medium">
          Three destinations, three different loudness readings, one ingest.
        </h2>
        <p class="mt-4 text-pretty leading-relaxed text-muted">
          One three-track source feeds all three destinations. The meters read
          <span class="font-mono text-fg">−15.6</span>,
          <span class="font-mono text-fg">−17.0</span> and
          <span class="font-mono text-fg">−21.9&nbsp;LUFS</span> because each
          was sent a different set of tracks — loudness is measured per
          destination, after routing, on the programme that destination
          actually receives.
        </p>
        <p class="mt-3 text-pretty text-sm leading-relaxed text-subtle">
          This capture is a different source from the example above: track 1 is
          the host mic, track 2 the music bed, track 3 the co-host. So Twitch's
          <span class="font-mono">01&nbsp;+&nbsp;03</span> is the mix with the
          music left out, and it reads quieter for exactly that reason.
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
        <LoudnessBars />
        <figure>
          {/* Imported rather than referenced by URL: public/ is copied
              verbatim, so a path there cannot produce the smaller variants a
              phone should be getting. The widths and sizes match features.astro
              -- this figure sits in the same .wrap grid at the same ratio. */}
          <Picture
            src={meters}
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            widths={[420, 690, 960, 1440]}
            sizes="(min-width: 1024px) 690px, calc(100vw - 2.5rem)"
            alt="polyemesis audio meters: three destinations showing −15.6, −17.0 and −21.9 LUFS from one ingest, with three source tracks metering live"
            loading="lazy"
            decoding="async"
            class="w-full rounded-token border border-line"
          />
          <figcaption class="mt-3 font-mono text-[11px] text-subtle">
            A capture from a running install. The bars on the left carry the same
            measured figures; their movement is illustrative, the numbers are not.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ features */}
  <section class="wrap py-20 sm:py-24" data-reveal>
    <div class="max-w-2xl">
      <p class="eyebrow">What else it does</p>
      <h2 class="mt-3 text-balance text-3xl font-medium">
        The rest of it is a broadcast server.
      </h2>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden rounded-token border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f) => (
          <div class="bg-surface p-6">
            <h3 class="text-pretty text-[15px] font-medium leading-snug text-fg">{f.t}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{f.d}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-subtle">
      <a href="/features" class="inline-block py-1 text-primary-bright hover:underline">The full list →</a>
    </p>
  </section>

  {/* ---------------------------------------------------- how it is built */}
  <section class="border-t border-line bg-surface/30 py-20 sm:py-24" data-reveal>
    <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="eyebrow">How it is built</p>
        <h2 class="mt-3 text-balance text-3xl font-medium">Decisions you can rely on.</h2>
        <p class="mt-4 text-sm leading-relaxed text-subtle">
          Four choices that shape everything else. Each one was made on purpose
          and is held to release after release.
        </p>
      </div>
      <dl class="divide-y divide-line border-y border-line">
        {
          [
            ["SRT carries every audio track", "One ingest accepting up to 32 tracks — six is what OBS sends — and each destination takes the mix you route to it. It works on any FFmpeg above the floor and it is the path that is operated daily, so the feature this product exists for is the one with the most road behind it. RTMP sits alongside it as the single-track fallback; Enhanced RTMP carries more on FFmpeg 7.1+, though an OBS-as-publisher run has not been confirmed."],
            ["Routing audio never touches your picture", "Video is stream-copied end to end, so the frames a platform receives are the frames your encoder made, and the cost of routing scales with audio rather than resolution. Shared renditions re-encode video only when you ask for one, and the cost of that encode is shown before it starts."],
            ["One binary, one config file", "No database to run, no broker, no container required. It installs as a systemd service on hardware you control, with no hosted service behind it and no per-destination pricing — the only connections it makes are the ones you configure."],
            ["Built for the operator at the desk", "One account and full control — no permission model to configure and none to get wrong. Live ingest, destination and process state are on one screen, and the routing you compiled is shown as the FFmpeg filter graph it became."],
          ].map(([t, d]) => (
            <div class="py-4">
              <dt class="text-[15px] font-medium text-fg">{t}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-muted">{d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* --------------------------------------------------------- who it is for */}
  {/* NAMING WHO SHOULD NOT USE THIS is the point of the second column, and it is
      the reason this section exists. Both reviews said the same thing from
      different angles: the site never states its own limits, and a product that
      cannot say who it is wrong for reads as marketing.

      It sits immediately before the call to action deliberately. A reader who
      recognises themselves in the right-hand column should leave here rather
      than install, discover the mismatch, and conclude the software is bad at
      something it never claimed. */}
  <section class="border-t border-line py-20 sm:py-24" data-reveal>
    <div class="wrap">
      <h2 class="text-balance text-3xl font-medium">Is this for you?</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <div class="card p-6">
          <p class="font-mono text-[11px] uppercase tracking-wider text-accent">Built for</p>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>You already run a server, or are willing to. A VPS is enough.</li>
            <li>You stream to more than one platform and want each to hear something different.</li>
            <li>Your VODs get muted, and a music-free second track would fix it.</li>
            <li>You are comfortable with a config file and a terminal.</li>
          </ul>
        </div>
        <div class="card p-6">
          <p class="font-mono text-[11px] uppercase tracking-wider text-subtle">Not built for</p>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>
              You want somebody else to run it. There is no hosted tier, and no
              plan for one. Hosted services exist and are good at it —{" "}
              <a href="/free-restream-service" class="underline decoration-line underline-offset-4 hover:text-fg">what you trade either way</a>{" "}
              is written out.
            </li>
            <li>You need a browser studio, guest invites, or cloud recording storage.</li>
            <li>You want support with an SLA. This is MIT software maintained in the open.</li>
            <li>One platform, one mix. You do not need any of this.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------------- cta */}
  <section class="wrap py-20 sm:py-28" data-reveal>
    <div class="card relative overflow-hidden px-6 py-14 text-center sm:px-12">
      <div class="signal-grid absolute inset-0" aria-hidden="true"></div>
      <div class="relative">
        <h2 class="text-balance text-3xl font-medium sm:text-4xl">
          One binary. One config file. Your hardware.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-pretty leading-relaxed text-muted">
          No account, nothing phoning home, no hosted tier to graduate to. Pull the
          image or download the binary and point OBS at it.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/download" class="btn btn-primary">Install polyemesis</a>
          <a
            href="https://github.com/rainmanjam/polyemesis"
            rel="noopener"
            class="btn btn-ghost">Read the source</a
          >
        </div>
      </div>
    </div>
  </section>
</Base>

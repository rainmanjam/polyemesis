---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import JourneyBar from "../components/home/JourneyBar.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import MixMatrixPlay from "../components/home/MixMatrixPlay.astro";
import Audiences from "../components/home/Audiences.astro";
import FeatureTour from "../components/home/FeatureTour.astro";
import StreamDeck from "../components/home/StreamDeck.astro";
import CalcMini from "../components/home/CalcMini.astro";
import Why from "../components/home/Why.astro";
import Install from "../components/home/Install.astro";
import Use from "../components/home/Use.astro";
---

{/* index.astro only assembles the sections; the copy lives in components/home/.

    The sections are direct children of <main> (Base.astro) on purpose: the
    journey bar is position: sticky, and sticky holds only while its parent is
    on screen, so a wrapper element around it would unstick it as soon as the
    wrapper ended. It sits right after the hero and stays under the nav while
    the five stages scroll past.

    Title: problem first, brand second, and under 60 characters so a search
    result does not truncate it mid-clause. The previous one led with the
    product name and the phrase "per-destination audio routing", which is the
    vocabulary of someone who has already found the project — #143's finding was
    that the person with this problem searches for the problem. */}
<Base
  title="Multistream, a different mix per platform — polyemesis"
  description="Multistream to Twitch, YouTube, Kick, Facebook and X from one upload, with a different audio mix per destination and the video untouched. Free, open source, on your own server."
  path="/"
>
  <Hero />
  <JourneyBar />
  <HowItWorks />
  <MixMatrixPlay />
  <Audiences />
  <FeatureTour />
  <StreamDeck />
  <CalcMini />
  <Why />
  <Install />
  <Use />
  <script>
    const go = () => import("../scripts/home/boot").then((m) => m.boot(document));
    "requestIdleCallback" in window ? requestIdleCallback(go, { timeout: 2000 }) : setTimeout(go, 200);
  </script>
</Base>

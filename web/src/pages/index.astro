---
import Base from "../layouts/Base.astro";
import CodeBlock from "../components/CodeBlock.astro";
import SignalPath from "../components/SignalPath.astro";
import Problem from "../components/home/Problem.astro";
import HowItWorks from "../components/home/HowItWorks.astro";
import Recovery from "../components/home/Recovery.astro";
import Run from "../components/home/Run.astro";
/* Counted, never typed. A literal "23 documents" in the explore row below is a claim
 * that goes stale the first time somebody publishes a document, and nothing
 * would fail — the page would simply be wrong about the thing it is inviting
 * you to read. docs.mjs is the allowlist, so it is also the count. */
import { PUBLISHED } from "../data/docs.mjs";
/* Read from GitHub at build time, and null when that read fails. The trust
 * line below prints the star count and release only when this is present, so
 * a failed fetch yields a plain link, never a number. See lib/github-stats.ts. */
import { fetchRepoStats } from "../lib/github-stats";
const repo = await fetchRepoStats();
---

{/* Title: problem first, brand second, and under 60 characters so a search
    result does not truncate it mid-clause. The previous one led with the
    product name and the phrase "per-destination audio routing", which is the
    vocabulary of someone who has already found the project — #143's finding was
    that the person with this problem searches for the problem. */}
<Base
  title="Multistream, a different mix per platform — polyemesis"
  description="Self-hosted multistreaming with a different audio mix per platform. One SRT ingest carries OBS's split tracks — send the clean feed where music gets muted."
  path="/"
  announce={{ release: repo?.release ?? null }}
>
  {/* ---------------------------------------------------------------- hero */}
  {/* THE HERO IS SHAPED AROUND ONE ACTION AND ONE PICTURE (S1, approved).
      Outcome headline, one-sentence subhead, then the install command with a
      primary Copy button. The quickstart is a text link, not a second button,
      because a hero with two equal buttons has no primary action. The
      calculator sits BELOW the actions: it answers "what will this cost my
      uplink" after the reader has decided to install, so it no longer sits
      between the subhead and the command. The first screen shows the real
      routing UI, not a CSS drawing of it.

      The install caveat (password, /udp, port 1935) is cut to one sentence
      here. The quickstart carries the full version, and the port reasons are
      written out there with the commands that need them. */}
  <section class="relative overflow-hidden border-b border-line">
    <div class="signal-grid absolute inset-0" aria-hidden="true"></div>
    <div class="wrap relative py-12 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          {/* THE HEADLINE AND LEDE ARE THE SIGNAL PATH'S (2026-11 hero). One
              outcome line with one composed break, no pill above it and no
              colour in it. The lede is ONE sentence on purpose (home-copy.test
              holds that): the prototype's two sentences became one. */}
          <h1 class="rise rise-1 text-balance text-4xl font-bold leading-[1.06] sm:text-5xl lg:text-[3.4rem]">
            One stream in.<br />
            Your mix, everywhere.
          </h1>
          <p class="rise rise-2 mt-6 max-w-lg text-pretty text-lg leading-relaxed text-muted">
            One upload from OBS goes out as the same video everywhere, with a different audio mix for each destination.
          </p>
        </div>

        <div class="rise rise-3">
          <CodeBlock
            label="docker"
            codeId="install-command"
            externalCopy
            code={`docker run -d --name polyemesis \\
  -p 8080:8080 -p 6000:6000/udp -p 1935:1935 \\
  -v polyemesis-data:/data \\
  rainmanjam/polyemesis:latest`}
          />

          {/* ONE COPY ACTION, and it is the primary control (2026-11 design
              review). The block above renders no Copy of its own
              (`externalCopy`), so this button is the only thing on the hero
              that copies the command. It carries `data-code-copy`, which is
              how check-build pairs the block's <pre> with one copy control,
              and `data-copy-target`, which is how the script finds the text
              from outside the box. */}
          <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button
              type="button"
              class="btn btn-primary"
              data-code-copy
              data-copy-target="install-command"
            >
              Copy install command
            </button>
            <a
              href="/docs/quickstart"
              class="tap text-sm text-fg underline decoration-line underline-offset-4 transition-colors hover:decoration-primary-bright"
            >
              Read the quickstart
            </a>
          </div>

          <p class="mt-4 text-sm text-subtle">
            Needs Docker. The ports and the first-run admin password are in the{" "}
            <a href="/docs/quickstart" class="text-fg underline decoration-line underline-offset-4 hover:text-primary-bright">quickstart</a>.
          </p>

          <p class="mt-4 text-sm text-subtle">
            Planning bandwidth first?{" "}
            <a
              href="/calculator"
              class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:decoration-primary-bright"
            >
              Bandwidth calculator
            </a>
          </p>
        </div>
      </div>

      {/* THE PICTURE IS THE INTERACTIVE SIGNAL PATH (replaces the routing
          screenshot of #963). Real HTML first, so it reads without JS; its
          animation loads lazily. See SignalPath.astro. */}
      <div class="rise rise-4 mt-10 lg:mt-12">
        <SignalPath />
      </div>
    </div>
  </section>

  <Problem />

  <HowItWorks />

  <Recovery />

  <Run />

  {/* --------------------------------------------------------- who it is for */}
  {/* SAYING WHEN ANOTHER TOOL FITS BETTER is the point of the second column,
      and it is the reason this section exists. Both reviews said the same
      thing from different angles: a product that cannot say who it suits
      reads as marketing.

      PHRASED AS A CHOICE, NOT A VERDICT (2026-11 design review). The labels
      were the mono caps pair "BUILT FOR / NOT BUILT FOR", which read as a spec
      sheet's exclusions. They are sentence-case headings now, each naming the
      choice a reader makes, and the second column says what a hosted service
      is good at rather than what polyemesis lacks.

      It sits immediately before the call to action deliberately. A reader who
      recognises themselves in the right-hand column is better served by the
      comparison than by an install. */}
  <section class="border-t border-line py-20 sm:py-24">
    <div class="wrap">
      <h2 class="text-balance text-3xl font-medium">Is this for you?</h2>
      <div class="card-grid card-grid--2 mt-10">
        <div class="card p-6">
          <h3 class="text-lg font-medium text-fg">Choose polyemesis if</h3>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>You stream to more than one platform and want each to hear something different.</li>
            <li>
              Your VODs get muted for music, and a music-free mix would fix it. Twitch can even keep the music live and drop it from the VOD (experimental; Twitch requires a GPU):{" "}
              <a href="/twitch-vod-track" class="underline decoration-line underline-offset-4 hover:text-fg">how the Twitch VOD track works</a>.
            </li>
            <li>You have a small server, or are happy to rent one. A VPS is enough.</li>
          </ul>
        </div>
        <div class="card p-6">
          <h3 class="text-lg font-medium text-fg">Choose a hosted service if</h3>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>
              You want somebody else to run it. Hosted services are good at that.{" "}
              <a href="/free-restream-service" class="underline decoration-line underline-offset-4 hover:text-fg">What you trade either way</a>{" "}
              is written out.
            </li>
            <li>You want a browser studio, guest invites or cloud recording storage.</li>
            <li>You send one mix to one platform and want nothing extra to run.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------- trust line, explore */}
  {/* The trust line is the stars/release span plus the source link, unchanged
      from the old call-to-action card. The explore row replaces that card's
      three document tiles: the page ends on where to go next, not on a sell. */}
  <section class="wrap pb-20 pt-4 sm:pb-24">
    <p class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm">
      <a
        href="https://github.com/rainmanjam/polyemesis"
        rel="noopener"
        class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:text-primary-bright hover:decoration-primary-bright">Read the source</a
      >
      {repo && (
        <span class="text-subtle">
          {repo.stars} {repo.stars === 1 ? "star" : "stars"} on GitHub
          {repo.release && <> · release {repo.release}</>}
        </span>
      )}
    </p>
    <nav aria-label="Explore" class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
      <a href="/docs/quickstart" class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:text-primary-bright hover:decoration-primary-bright">Quickstart</a>
      <a href="/docs" class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:text-primary-bright hover:decoration-primary-bright">All {PUBLISHED.length} documents</a>
      <a href="/features" class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:text-primary-bright hover:decoration-primary-bright">Features</a>
      <a href="/comparison" class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:text-primary-bright hover:decoration-primary-bright">Comparison</a>
      <a href="/calculator" class="tap text-fg underline decoration-line underline-offset-4 transition-colors hover:text-primary-bright hover:decoration-primary-bright">Bandwidth calculator</a>
    </nav>
  </section>

  <script>
    const go = () => import("../scripts/home/boot").then((m) => m.boot(document));
    "requestIdleCallback" in window ? requestIdleCallback(go, { timeout: 2000 }) : setTimeout(go, 200);
  </script>
</Base>

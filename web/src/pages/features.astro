---
/* /features, rebuilt on the inner-page shell from src/data/features.mjs.
 *
 * Seven sections in a fixed order, the five in-depth ones each laid out
 * differently (data-layout): the audio lead, an inputs table with a ports
 * diagram, the failover demo, chat beside its capture, and four recording
 * verbs above theirs. Section ids are literal on purpose: the order test reads
 * this file. Every screenshot goes through Shot, which fails the build for a
 * missing capture. The deck still is an Image because it is a photograph-style
 * render, not a console screenshot. */
import { Image } from "astro:assets";
import InnerPage from "../layouts/InnerPage.astro";
import Shot from "../components/inner/Shot.astro";
import CompareTable from "../components/inner/CompareTable.astro";
import FailoverLadder from "../components/features/FailoverLadder.astro";
import deckStill from "../assets/home/deck-still.jpg";
import { TRACK_LAYOUT } from "../data/tracks.mjs";
import { SCREENS, LEAD, ROOMS, INPUTS, FAILOVER_FACTS, CHAT_FACTS, RECORDING_VERBS, DECK_FACTS, ALSO } from "../data/features.mjs";
import { splitAccent } from "../lib/accent";

/* "track 1 is the host mic, track 2 is the co-host mic, ... and track 4 is the
 * room." Built from the shared layout so the sentence cannot name a track the
 * capture does not have. */
const LAYOUT_SENTENCE =
  TRACK_LAYOUT.map(
    (t, i) => `${i === TRACK_LAYOUT.length - 1 ? "and " : ""}track ${t.id} is the ${t.name.toLowerCase()}`,
  ).join(", ") + ".";

const shot = (id: string) => SCREENS.find((s) => s.id === id)!;
const [leadBefore, leadWord, leadAfter] = splitAccent(LEAD.heading, LEAD.accent);

const index = [
  { id: "audio", label: "Per-destination audio" },
  { id: "inputs", label: "Inputs and bonding" },
  { id: "failover", label: "Failover" },
  { id: "chat", label: "Chat and moderation" },
  { id: "recordings", label: "Recordings and clips" },
  { id: "deck", label: "Stream Deck plugin" },
  { id: "also", label: "Also included" },
];

const [, ...inputRows] = INPUTS;
---

<InnerPage
  title="Multistreaming features — a different audio mix per platform"
  description="Route your OBS split audio tracks per destination: a channel-level mix matrix, shared renditions and multitrack recording. Self-hosted."
  path="/features"
  crumbs={[{ label: "polyemesis", href: "/" }, { label: "features" }]}
  heading="A server built around one feature."
  accent="feature"
  lede="Every destination gets its own audio mix, from the same video."
  index={index}
  lightbox
  band={{
    heading: "One broadcast. Every audience.",
    accent: "Every",
    secondary: { label: "How it compares", href: "/comparison" },
  }}
>
  <a slot="actions" class="btn btn-primary" href="/download">Install polyemesis</a>
  <a slot="actions" class="btn btn-ghost" href="#audio">See the audio routing</a>

  <section id="audio" class="fe" data-layout="lead" aria-labelledby="h-audio">
    <p class="eyebrow"><b>{LEAD.eyebrow}</b></p>
    <h2 id="h-audio">{leadBefore}<em class="it">{leadWord}</em>{leadAfter}</h2>
    {LEAD.body.map((t) => <p class="fe-body">{t}</p>)}
    <p class="fe-body">
      Twitch can also take a second audio track for its VOD; Twitch requires a GPU, and a host that reports none is refused the negotiation outright. <a href="/twitch-vod-track">Read how the Twitch VOD track works</a>.
    </p>
    <p class="fe-links">
      <a class="more" href="/#matrix">Play with the routing matrix</a>
      <a class="more" href="/docs/audio-routing">Read about audio routing</a>
    </p>
    <div class="fe-shot">
      <Shot shot={shot("audio").shot} alt={shot("audio").alt} caption={`Track layout in this capture: ${LAYOUT_SENTENCE}`} chrome="Routing" />
    </div>
    <div class="fe-rooms">
      {
        ROOMS.map((r) => (
          <article class="fe-room panel">
            <h3>{r.title}</h3>
            <p>{r.body}</p>
            <table class="fe-route" data-room-routing>
              <caption class="sr-only">{`Routing for ${r.title}: track, then destination`}</caption>
              <tbody>
                {r.routes.map(([from, to]) => (
                  <tr>
                    <th scope="row">{from}</th>
                    <td>{to}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            {r.note && <p class="fe-note">{r.note}</p>}
            {r.link && <a class="more" href={r.link.href}>{r.link.text}</a>}
          </article>
        ))
      }
    </div>
  </section>

  <section id="inputs" class="fe" data-layout="table-diagram" aria-labelledby="h-inputs">
    <p class="eyebrow">Inputs</p>
    <h2 id="h-inputs">One port per protocol, many programmes.</h2>
    <div class="fe-split">
      <div>
        <p class="fe-body">
          Sources are told apart by a publish token, supplied in OBS's Stream Key field on RTMP and as the streamid on SRT, so a second programme never means opening a second port.
        </p>
        <p class="fe-links"><a class="more" href="/docs/srtla">Read about bonded links</a></p>
      </div>
      <div class="fe-ports panel">
        <svg viewBox="0 0 280 160" role="img" aria-label="Ports: SRT on 6000 UDP, RTMP on 1935, SRTLA on 5000 UDP when enabled, and the console on 8080 all reach polyemesis">
          <rect class="fe-hub" x="170" y="14" width="100" height="132" />
          <text class="fe-p" x="220" y="84" text-anchor="middle">polyemesis</text>
          <path d="M112 30H170M112 62H170M112 94H170M112 126H170" />
          <text class="fe-p" x="6" y="34">SRT</text><text x="66" y="34">6000/udp</text>
          <text class="fe-p" x="6" y="66">RTMP</text><text x="66" y="66">1935</text>
          <text class="fe-p" x="6" y="98">SRTLA</text><text x="66" y="98">5000/udp</text><text x="66" y="112">when enabled</text>
          <text class="fe-p" x="6" y="130">console</text><text x="66" y="130">8080</text>
        </svg>
      </div>
    </div>
    <div class="fe-table">
      <CompareTable
        caption="What each input carries into per-destination audio"
        firstHeader={INPUTS[0][0]}
        cols={[
          { key: "tracks", name: INPUTS[0][1] },
          { key: "good", name: INPUTS[0][2] },
        ]}
        rows={inputRows}
      />
    </div>
    <div class="fe-shot">
      <Shot shot={shot("inputs").shot} alt={shot("inputs").alt} caption={shot("inputs").caption} chrome="Sources" />
    </div>
  </section>

  <section id="failover" class="fe" data-layout="ladder" aria-labelledby="h-failover">
    <p class="eyebrow">Failover</p>
    <h2 id="h-failover">When the encoder dies, the destinations stay up.</h2>
    <div class="fe-fail">
      <FailoverLadder />
      <div>
        <ul class="fe-facts rows">
          {FAILOVER_FACTS.map((t) => <li>{t}</li>)}
        </ul>
        <p class="fe-links"><a class="more" href="/docs/link-health">Read about failover</a></p>
      </div>
    </div>
  </section>

  <section id="chat" class="fe" data-layout="shot-left" aria-labelledby="h-chat">
    <p class="eyebrow">Chat</p>
    <h2 id="h-chat">Five platforms in one timeline.</h2>
    <div class="fe-chat">
      <div class="fe-shot">
        <Shot shot={shot("chat").shot} alt={shot("chat").alt} caption={shot("chat").caption} chrome="Chat" />
      </div>
      <div>
        <dl class="fe-dl rows">
          {
            CHAT_FACTS.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.text}</dd>
              </div>
            ))
          }
        </dl>
        <p class="fe-links">
          <a class="more" href="/docs/automod">Read about automatic moderation</a>
          <a class="more" href="/docs/platforms">Platforms and what each allows</a>
        </p>
      </div>
    </div>
  </section>

  <section id="recordings" class="fe" data-layout="verbs" aria-labelledby="h-recordings">
    <p class="eyebrow">Recordings</p>
    <h2 id="h-recordings">The full multitrack archive, stream-copied.</h2>
    <ul class="fe-verbs">
      {
        RECORDING_VERBS.map((v) => (
          <li>
            <h3>{v.verb}</h3>
            <p>{v.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="fe-shot">
      <Shot shot={shot("recordings").shot} alt={shot("recordings").alt} caption={shot("recordings").caption} chrome="Recordings" />
    </div>
  </section>

  <section id="deck" class="fe" data-layout="deck" aria-labelledby="h-deck">
    <p class="eyebrow">Stream Deck</p>
    <h2 id="h-deck">Control the stream from a Stream Deck.</h2>
    <div class="fe-deck">
      <Image
        src={deckStill}
        alt="A Stream Deck + running the polyemesis plugin: eight keys, Go live, Stop all and Routing preset, then five destinations each with its platform mark, all live, with the touch strip and four dials below."
        widths={[640, 1025]}
        sizes="(min-width: 1024px) 520px, calc(100vw - 2.5rem)"
        loading="lazy"
      />
      <ul>
        {DECK_FACTS.map((t) => <li>{t}</li>)}
      </ul>
    </div>
    <p class="fe-links">
      <a class="more" href="/#deck">See it on the homepage</a>
      <a class="more" href="/docs/stream-deck">Read the plugin guide</a>
    </p>
    <p class="fe-fine">Stream Deck + model: Elgato</p>
    <p class="fe-fine">
      polyemesis is not affiliated with or endorsed by YouTube, Twitch, Kick, Rumble, Facebook, Meta, X or Elgato; their names and logos are trademarks of their owners.
    </p>
  </section>

  <section id="also" class="fe" data-layout="also" aria-labelledby="h-also">
    <p class="eyebrow">And more</p>
    <h2 id="h-also">Also included.</h2>
    <div class="fe-also rows">
      {
        ALSO.map((g) => (
          <section>
            <div>
              <h3>{g.group}</h3>
              <p>{g.blurb}</p>
            </div>
            <ul>
              {g.items.map((i) => (
                <li>
                  <b>{i.name}</b>
                  <p>{i.text}</p>
                  <a class="more" href={`/docs/${i.doc}`}>Docs</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</InnerPage>

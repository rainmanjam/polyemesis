---
import InnerPage from "../layouts/InnerPage.astro";
import { SECTIONS, START_HERE, BY_FILE, docsIn, hrefOf } from "../data/docs.mjs";
import type { IndexItem } from "../lib/page-index";

/* A DIRECTORY THAT NOW POINTS AT PAGES, not at github.com.
 *
 * This file used to argue that mirroring the repo's markdown onto a website
 * "would guarantee a page that disagrees with the software it documents", and
 * linked out to GitHub instead. Half of that was right and half of it was the
 * reason 63,000 words of this project's documentation were invisible to search:
 * every query it could have won landed on github.com, so the authority accrued
 * to Microsoft's domain and the pages had no title, no description and no
 * internal linking under anyone's control here.
 *
 * The objection is answered rather than overruled. The pages are RENDERED FROM
 * the files in docs/ at build time -- there is no copy to drift, and a document
 * edited in the same commit as the code it describes ships with it. src/data/
 * docs.mjs is the allowlist and the written metadata; content.config.ts loads
 * the originals.
 */

const startHere = START_HERE.map((f) => BY_FILE.get(f)).filter((d) => d !== undefined);
const index: IndexItem[] = [
  { id: "start-here", label: "Start here" },
  ...SECTIONS.map((s) => ({ id: s.id, label: s.title })),
];
---

<InnerPage
  title="polyemesis docs — OBS setup, audio routing, API"
  description="Setup, per-destination audio routing, operations and API reference for polyemesis, the self-hosted SRT restreaming server. Versioned with the code."
  path="/docs"
  crumbs={[{ label: "polyemesis", href: "/" }, { label: "docs" }]}
  heading="The docs live with the code."
  lede="Every page below is rendered from a file in docs/ in the repository, so it is versioned alongside the software rather than maintained as a second copy that disagrees with it."
  index={index}
  band={{
    heading: "Something wrong or missing?",
    lede: "The docs are in the same repository as the code, under docs/. Corrections are a pull request, and the ones that say “this was wrong and here is why” are the most useful kind.",
    secondary: { label: "Open an issue", href: "https://github.com/rainmanjam/polyemesis/issues" },
  }}
>
  <Fragment slot="actions">
    <a href="/download" class="btn btn-primary">Install polyemesis</a>
  </Fragment>
  <Fragment slot="meta">
    They track <span class="mono">main</span>, which runs ahead of the latest release. If you are running one, read the copies in your own checkout.
  </Fragment>

  {/* The written title and description: the same two strings the page's own
      <title> and <meta name=description> carry. One pair rather than two, so
      an index blurb and a search snippet cannot disagree. */}
  <section id="start-here" class="docs-start">
    <h2>Start here</h2>
    <ul class="rows dl">
      {startHere.map((d) => (
        <li>
          <a href={hrefOf(d)}>
            <span class="dl-t">
              <b>{d.title}</b>
              <i>{d.file}</i>
            </span>
            <span class="dl-d">{d.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {
    SECTIONS.map((s) => {
      const docs = docsIn(s.id);
      return (
        <details class="grp" id={s.id} open>
          <summary>
            <h2>{s.title}</h2>
            <span class="blurb">{s.blurb}</span>
            <span class="cnt">{docs.length} docs</span>
          </summary>
          <ul class="rows dl">
            {docs.map((d) => (
              <li>
                <a href={hrefOf(d)}>
                  <span class="dl-t">
                    <b>{d.title}</b>
                    <i>{d.file}</i>
                  </span>
                  <span class="dl-d">{d.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })
  }
</InnerPage>

---
import Base from "../layouts/Base.astro";
---

<Base title="Not found — polyemesis" description="That page does not exist." path="/404">
  <section class="wrap py-28 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-balance text-4xl font-bold">That route has no destination.</h1>
    <p class="mx-auto mt-4 max-w-md text-pretty leading-relaxed text-muted">
      The page you asked for is not here. The routing matrix, on the other hand,
      definitely is.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to the start</a>
      <a href="/docs" class="btn btn-ghost">Documentation</a>
    </div>
  </section>
</Base>

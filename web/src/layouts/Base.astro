---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/features". Defaults to the current URL. */
  path?: string;
  /** Keep this page out of the index, and out of the structured data.
   *
   *  Only the 404 sets it. A 404 that carries a canonical URL and a
   *  SoftwareApplication block is a page Google can decide to index -- a soft
   *  404, competing with the real pages for the same brand terms and offering a
   *  visitor nothing when it wins. `noindex` is what makes the canonical safe to
   *  keep: the canonical stops /404 and /404.html being seen as duplicates,
   *  while noindex stops either being indexed at all. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonical = new URL(path ?? Astro.url.pathname, Astro.site ?? "https://polyemesis.com");
const ogImage = new URL("/og.png", Astro.site ?? "https://polyemesis.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    {/* DIMENSIONS AND ALT, because a scraper that has not fetched the image yet
        uses them to reserve the space -- without them some unfurls render a
        blank box until the download finishes, and some skip the image.

        2560x1280 is 2:1. The documented target is 1.91:1, and the difference is
        small enough that platforms letterbox rather than crop badly, so the
        numbers below state what the file IS rather than what we wish it were.
        Reshooting it at 1200x630 is a separate change. */}
    <meta property="og:image:width" content="2560" />
    <meta property="og:image:height" content="1280" />
    <meta property="og:image:alt" content="polyemesis — one source, a different audio mix to every platform" />
    <meta property="og:site_name" content="polyemesis" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="polyemesis — one source, a different audio mix to every platform" />

    {/* Structured data. Every property here is checkable against the repo —
        there is deliberately no aggregateRating, because inventing review
        counts to win a star rating in search results is exactly the kind of
        thing the audience for a self-hosted broadcast server would notice and
        hold against the project. `offers` at price 0 is the honest way to say
        "free and MIT" in a vocabulary search engines read. */}
    {/* Not emitted on a noindex page. Structured data is a claim about what the
        page IS, and a 404 is not a SoftwareApplication -- shipping the product's
        JSON-LD there invites the soft-404 the noindex above exists to prevent. */}
    {!noindex && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "polyemesis",
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Live video streaming server",
      operatingSystem: "Linux, macOS, Windows",
      url: "https://polyemesis.com",
      downloadUrl: "https://github.com/rainmanjam/polyemesis/releases/latest",
      codeRepository: "https://github.com/rainmanjam/polyemesis",
      license: "https://spdx.org/licenses/MIT.html",
      softwareRequirements: "FFmpeg 6.0 or newer, built with libsrt for multitrack SRT ingest",
      description:
        "Self-hosted live restreaming and multistreaming server with " +
        "per-destination multichannel audio routing. One SRT ingest carrying " +
        "the split audio tracks from OBS; each destination receives its own " +
        "mix, built here rather than selected upstream. Video is stream-copied " +
        "by default; optional shared renditions re-encode it.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      isAccessibleForFree: true,
    })} />
    )}

    <meta name="theme-color" content="#0b0d11" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* iOS will not use an SVG favicon and will not invent a raster from one --
        without this, a page saved to a home screen gets a blank tile or a
        screenshot of the page. 180x180 is the size iOS requests; it downsamples
        for every smaller slot itself.

        Rendered from favicon.svg with the corner radius REMOVED. Apple applies
        its own squircle mask, so a source that is already rounded shows the
        theme's corners inside Apple's, with transparent gaps between them. The
        file is full-bleed square on purpose; see web/public/apple-touch-icon.png. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    {/* Self-hosted, not linked. A font request to a third party is a request the
        visitor did not make and the slowest thing on an otherwise static page.
        All three are variable fonts subset to latin, so the whole typographic
        system is 94 KB — one file per family covering every weight used. */}
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    {/* THE THIRD FACE WAS THE ONE LEFT OUT, and it is above the fold on every
        page: the hero eyebrow, the `docker run` line a visitor copies, the
        footer column labels. Measured on the live site over Slow 4G it began
        loading 592ms after its two preloaded siblings, because the browser only
        learned it was needed once the stylesheet had been parsed.

        No extra bytes — the file is fetched either way. This only moves the
        discovery earlier. */}
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face {
        font-family: "Space Grotesk";
        src: url("/fonts/space-grotesk.woff2") format("woff2");
        font-weight: 400 700;
        font-display: swap;
      }
      @font-face {
        font-family: "IBM Plex Sans";
        src: url("/fonts/ibm-plex-sans.woff2") format("woff2");
        font-weight: 400 600;
        font-display: swap;
      }
      @font-face {
        font-family: "JetBrains Mono";
        src: url("/fonts/jetbrains-mono.woff2") format("woff2");
        font-weight: 400 500;
        font-display: swap;
      }
    </style>
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-ink"
      >Skip to content</a
    >
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Entry reveals, for browsers without scroll-driven animations. Where
        `animation-timeline: view()` exists the CSS drives it and this never
        runs — the check is the same @supports test, asked from script.

        The elements start visible in the markup and are only hidden once this
        script has confirmed it can bring them back. A reader with JavaScript
        off, or one whose network drops this file, sees the whole page rather
        than a column of blank space. */}
    <script is:inline>
      (() => {
        const css = window.CSS;
        if (css && css.supports && css.supports("animation-timeline", "view()")) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const targets = document.querySelectorAll("[data-reveal]");
        if (!targets.length || !("IntersectionObserver" in window)) return;

        targets.forEach((el) => el.classList.add("reveal"));

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("shown");
              io.unobserve(e.target); // reveal once; re-animating on scroll-back is nausea, not polish
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

---
import Base from "./Base.astro";
import { SECTIONS, PUBLISHED, hrefOf, GITHUB_BLOB } from "../data/docs.mjs";
import Crumbs from "../components/inner/Crumbs.astro";
import DocNav from "../components/inner/DocNav.astro";
import PageIndex from "../components/inner/PageIndex.astro";
import type { Crumb } from "../lib/breadcrumbs";
import type { DocHeading } from "../lib/doc-headings";
import type { IndexItem } from "../lib/page-index";

/* One document, rendered. The chrome around it is navigation and nothing else:
 * a reader who lands here from a search result has no idea 22 other pages exist,
 * and a flat page with no sidebar is how documentation stays a set of dead ends.
 */

interface Props {
  /** The manifest entry. Carries the written title, description and section. */
  doc: import("../data/docs.mjs").Doc;
  /** The article's h2 and h3, read from its markdown. Empty: no index at all. */
  headings: DocHeading[];
}

const { doc, headings } = Astro.props;
const section = SECTIONS.find((s) => s.id === doc.section);
const here = hrefOf(doc);

/* Previous and next in manifest order, which is reading order rather than
 * alphabetical. Two more internal links per page, pointing at the document
 * somebody genuinely needs next -- QUICKSTART to INSTALL, not to API. */
const order = PUBLISHED.findIndex((d) => d.slug === doc.slug);
const prev = order > 0 ? PUBLISHED[order - 1] : undefined;
const next = order < PUBLISHED.length - 1 ? PUBLISHED[order + 1] : undefined;

/* The trail is visible, so the BreadcrumbList that Crumbs embeds is honest. The
 * group has no page of its own: it points at its block on the docs index. */
const crumbs: Crumb[] = [
  { label: "polyemesis", href: "/" },
  { label: "Docs", href: "/docs" },
  { label: section?.title ?? "Docs", href: section ? `/docs#${section.id}` : "/docs" },
  { label: doc.title, href: here },
];

/* An index of one link is a rail with nothing in it (check-build.mjs refuses
 * it), so below two headings the page has no "On this page" at all. */
const toc: IndexItem[] = headings.length >= 2 ? headings.map((h) => ({ id: h.slug, label: h.text, depth: h.depth })) : [];
---

<Base title={doc.title} description={doc.description} path={doc.canonical ?? here}>
  {/* THE COPY BUTTONS ON THIS PAGE ARE BUILT BY A PLUGIN, SO THE SCRIPT HAS TO
      BE ASKED FOR HERE.

      CodeBlock.astro imports the same module, and Astro emits it once for any
      page that uses the component. A documentation page never renders that
      component -- lib/hast-code-block.mjs emits its markup from the markdown
      instead -- so nothing pulled the script in, and 114 Copy buttons rendered,
      looked exactly right, and did nothing when clicked. Caught by clicking one;
      no build output says anything about it, which is why check-build.mjs now
      asserts that a page carrying these buttons also ships the code that reads
      them. */}
  <script>
    import "../scripts/code-copy.ts";
    /* Same reason as the copy buttons above: the diagram containers are built
       by lib/hast-mermaid.mjs from the markdown, so no component pulls this in
       and the page has to ask for it. The module itself checks whether the page
       actually has a diagram before importing mermaid, so the 22 documents
       without one pay for a querySelectorAll and nothing else. */
    import "../scripts/mermaid-render.ts";
    /* The shared inner-page boot: the motion gate, and the script that marks
       the current section in "On this page". */
    import { bootInner } from "../scripts/inner";
    bootInner(document);
  </script>

  <div class="wrap docgrid" data-toc={toc.length ? "some" : "none"}>
    <details class="docmenu">
      <summary>Documentation</summary>
      <DocNav current={doc.slug} />
    </details>

    {toc.length > 0 && <PageIndex items={toc} variant="phone" phone="disclosure" />}

    <aside class="docnav">
      <DocNav current={doc.slug} />
    </aside>

    <div class="doc-col" data-doc-column>
      <Crumbs crumbs={crumbs} />

      <article class="doc-prose">
        <slot />
      </article>

      <div class="doc-foot">
        <p class="doc-source">
          This page is rendered from{" "}
          <a href={`${GITHUB_BLOB}/docs/${doc.file}`} rel="noopener">
            <span class="font-mono">docs/{doc.file}</span>
          </a>{" "}
          in the repository, so it is versioned with the software it describes.
          It tracks <span class="font-mono">main</span>, which runs
          ahead of the latest release. If you are running one, read the copy in
          your own checkout. Corrections are a pull request.
        </p>

        {/* Prev/next, in reading order. Anchor text is the destination's title
            rather than "Next", because a link that names its target is worth
            something to a reader skimming and to everything else that reads
            this page. */}
        <div class="card-grid card-grid--2 mt-8" data-pager>
          {prev && (
            <a href={hrefOf(prev)} class="card group p-4 transition-colors hover:border-line-strong">
              <span class="eyebrow">Previous</span>
              <span class="mt-1 block text-[15px] text-fg">{prev.title}</span>
            </a>
          )}
          {next && (
            <a
              href={hrefOf(next)}
              class="card group p-4 transition-colors hover:border-line-strong md:col-start-2 md:text-right"
            >
              <span class="eyebrow">Next</span>
              <span class="mt-1 block text-[15px] text-fg">{next.title}</span>
            </a>
          )}
        </div>
      </div>
    </div>

    {toc.length > 0 && <PageIndex items={toc} variant="rail" />}
  </div>
</Base>

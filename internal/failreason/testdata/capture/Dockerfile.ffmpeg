# The FFmpeg the captures were taken with: the same Alpine release and the same
# pinned package as the shipping image (see the repository's Dockerfile), so a
# fixture is what a production destination would actually print.
FROM alpine:3.24
ARG FFMPEG_VERSION=8.1.3-r0
RUN apk add --no-cache "ffmpeg=${FFMPEG_VERSION}" ca-certificates iproute2 openssl

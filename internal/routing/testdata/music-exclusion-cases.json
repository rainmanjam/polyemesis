{
  "about": "Which tracks a destination leaves out as music. Read by internal/routing/music_exclusion_test.go (the server's own policy) and ui/src/lib/musicExclusion.test.ts (the console's excludedMusicTracks). Inputs: the destination's excludeRoles, and ITS OWN programme's tracks with their annotated role and whether the destination routes the track. Expected: the music tracks left out. keptRouted: the routed tracks whose cells must survive the server's compile (applyRolePolicy). carried:false means the ingest does not carry the track though it is annotated. serverRefuses: ValidateAnnotations rejects the annotations, so the console is not compared.",
  "cases": [
    {"name": "setting on, one music track", "excludeRoles": ["music"], "tracks": [{"track": 0, "role": "mic", "routed": true}, {"track": 1, "role": "music", "routed": true}], "excludedMusicTracks": [1], "keptRouted": [0]},
    {"name": "setting on, no music track", "excludeRoles": ["music"], "tracks": [{"track": 0, "role": "mic", "routed": true}, {"track": 1, "role": "game", "routed": true}], "excludedMusicTracks": [], "keptRouted": [0, 1]},
    {"name": "setting on, no annotations at all", "excludeRoles": ["music"], "tracks": [], "excludedMusicTracks": [], "keptRouted": []},
    {"name": "setting off, music track present", "excludeRoles": [], "tracks": [{"track": 1, "role": "music", "routed": true}], "excludedMusicTracks": [], "keptRouted": [1]},
    {"name": "only another role excluded", "excludeRoles": ["mic"], "tracks": [{"track": 0, "role": "mic", "routed": true}, {"track": 1, "role": "music", "routed": true}], "excludedMusicTracks": [], "keptRouted": [1]},
    {"name": "music and another role excluded", "excludeRoles": ["music", "mic"], "tracks": [{"track": 0, "role": "mic", "routed": true}, {"track": 2, "role": "music", "routed": true}], "excludedMusicTracks": [2], "keptRouted": []},
    {"name": "music track the destination does not route still counts", "excludeRoles": ["music"], "tracks": [{"track": 3, "role": "music", "routed": false}, {"track": 0, "role": "mic", "routed": true}], "excludedMusicTracks": [3], "keptRouted": [0]},
    {"name": "two music tracks, listed out of order", "excludeRoles": ["music"], "tracks": [{"track": 4, "role": "music", "routed": true}, {"track": 1, "role": "music", "routed": true}], "excludedMusicTracks": [1, 4], "keptRouted": []},
    {"name": "an unlabelled track is not music", "excludeRoles": ["music"], "tracks": [{"track": 0, "role": "", "routed": true}], "excludedMusicTracks": [], "keptRouted": [0]},
    {"name": "an annotated track the ingest does not carry still counts", "excludeRoles": ["music"], "tracks": [{"track": 0, "role": "mic", "routed": true}, {"track": 5, "role": "music", "routed": false, "carried": false}], "excludedMusicTracks": [5], "keptRouted": [0]},
    {"name": "excludeRoles listed twice", "excludeRoles": ["music", "music"], "tracks": [{"track": 2, "role": "music", "routed": true}, {"track": 0, "role": "game", "routed": true}], "excludedMusicTracks": [2], "keptRouted": [0]},
    {"name": "track indices that do not start at 0", "excludeRoles": ["music"], "tracks": [{"track": 2, "role": "mic", "routed": true}, {"track": 7, "role": "music", "routed": true}], "excludedMusicTracks": [7], "keptRouted": [2]},
    {"name": "a destination that routes nothing", "excludeRoles": ["music"], "tracks": [{"track": 1, "role": "music", "routed": false}, {"track": 0, "role": "mic", "routed": false}], "excludedMusicTracks": [1], "keptRouted": []},
    {"name": "a non-music routed track survives the exclusion", "excludeRoles": ["music"], "tracks": [{"track": 0, "role": "commentary", "routed": true}, {"track": 1, "role": "music", "routed": true}, {"track": 2, "role": "", "routed": true}], "excludedMusicTracks": [1], "keptRouted": [0, 2]},
    {"name": "a role string that is not music", "excludeRoles": ["music"], "tracks": [{"track": 0, "role": "mic ", "routed": true}, {"track": 1, "role": "musical", "routed": true}], "excludedMusicTracks": [], "keptRouted": [0, 1]},
    {"name": "two annotations on one track are refused by the server", "serverRefuses": true, "excludeRoles": ["music"], "tracks": [{"track": 1, "role": "music", "routed": true}, {"track": 1, "role": "mic", "routed": true}], "excludedMusicTracks": [1], "keptRouted": []}
  ]
}

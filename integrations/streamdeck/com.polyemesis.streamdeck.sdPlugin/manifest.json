{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.polyemesis.streamdeck",
  "Name": "Polyemesis",
  "Description": "Destination state, go live, stop all or one destination with confirmation, dump the broadcast delay, recording, routing presets, failover, track mute and gain, and dial meters for a polyemesis install.",
  "Author": "polyemesis",
  "Version": "0.1.0.0",
  "Icon": "imgs/plugin-icon",
  "Category": "Polyemesis",
  "CategoryIcon": "imgs/category-icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
